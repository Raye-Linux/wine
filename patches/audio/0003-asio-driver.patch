+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <time.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <sched.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <linux/futex.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(asio);
+
+/* The few JACK declarations used here, so the build does not need the
+ * JACK headers. */
+typedef UINT32 jack_nframes_t;
+typedef struct jack_client jack_client_t;
+typedef struct jack_port jack_port_t;
+typedef struct { jack_nframes_t min, max; } jack_latency_range_t;
+
+#define JackNoStartServer   0x01
+#define JackPortIsInput     0x01
+#define JackPortIsOutput    0x02
+#define JackPortIsPhysical  0x04
+#define JackCaptureLatency  0
+#define JackPlaybackLatency 1
+#define JACK_DEFAULT_AUDIO_TYPE "32 bit float mono audio"
+
+#ifndef SCHED_RESET_ON_FORK
+#define SCHED_RESET_ON_FORK 0x40000000
+#endif
+
+#define JACK_FUNCS \
+    DO_FUNC(jack_client_t *, jack_client_open, (const char *, int, int *, ...)) \
+    DO_FUNC(int, jack_client_close, (jack_client_t *)) \
+    DO_FUNC(jack_nframes_t, jack_get_sample_rate, (jack_client_t *)) \
+    DO_FUNC(jack_nframes_t, jack_get_buffer_size, (jack_client_t *)) \
+    DO_FUNC(int, jack_set_buffer_size, (jack_client_t *, jack_nframes_t)) \
+    DO_FUNC(jack_port_t *, jack_port_register, (jack_client_t *, const char *, const char *, unsigned long, unsigned long)) \
+    DO_FUNC(void *, jack_port_get_buffer, (jack_port_t *, jack_nframes_t)) \
+    DO_FUNC(const char *, jack_port_name, (const jack_port_t *)) \
+    DO_FUNC(const char **, jack_port_get_connections, (const jack_port_t *)) \
+    DO_FUNC(void, jack_port_get_latency_range, (jack_port_t *, int, jack_latency_range_t *)) \
+    DO_FUNC(int, jack_set_process_callback, (jack_client_t *, int (*)(jack_nframes_t, void *), void *)) \
+    DO_FUNC(int, jack_set_buffer_size_callback, (jack_client_t *, int (*)(jack_nframes_t, void *), void *)) \
+    DO_FUNC(int, jack_set_sample_rate_callback, (jack_client_t *, int (*)(jack_nframes_t, void *), void *)) \
+    DO_FUNC(int, jack_set_latency_callback, (jack_client_t *, void (*)(int, void *), void *)) \
+    DO_FUNC(int, jack_activate, (jack_client_t *)) \
+    DO_FUNC(int, jack_deactivate, (jack_client_t *)) \
+    DO_FUNC(const char **, jack_get_ports, (jack_client_t *, const char *, const char *, unsigned long)) \
+    DO_FUNC(int, jack_connect, (jack_client_t *, const char *, const char *)) \
+    DO_FUNC(int, jack_disconnect, (jack_client_t *, const char *, const char *)) \
+    DO_FUNC(void, jack_free, (void *)) \
+    DO_FUNC(int, jack_client_real_time_priority, (jack_client_t *))
+
+#define DO_FUNC(ret, name, args) static ret (*p##name) args;
+JACK_FUNCS
+#undef DO_FUNC
+
+/* Just enough of libdbus to ask RealtimeKit for a realtime thread. */
+typedef struct { const char *name, *message; unsigned int dummy; void *padding; } DBusError;
+#define DBUS_BUS_SYSTEM    1
+#define DBUS_TYPE_INVALID  0
+#define DBUS_TYPE_UINT32   'u'
+#define DBUS_TYPE_UINT64   't'
+
+#define DBUS_FUNCS \
+    DO_FUNC(void, dbus_error_init, (DBusError *)) \
+    DO_FUNC(void, dbus_error_free, (DBusError *)) \
+    DO_FUNC(void *, dbus_bus_get_private, (int, DBusError *)) \
+    DO_FUNC(void, dbus_connection_close, (void *)) \
+    DO_FUNC(void, dbus_connection_unref, (void *)) \
+    DO_FUNC(void *, dbus_message_new_method_call, (const char *, const char *, const char *, const char *)) \
+    DO_FUNC(int, dbus_message_append_args, (void *, int, ...)) \
+    DO_FUNC(void *, dbus_connection_send_with_reply_and_block, (void *, void *, int, DBusError *)) \
+    DO_FUNC(void, dbus_message_unref, (void *))
+
+#define DO_FUNC(ret, name, args) static ret (*p##name) args;
+DBUS_FUNCS
+#undef DO_FUNC
+
+struct asio_client
+{
+    jack_client_t *jack;
+    unsigned int inputs, outputs;
+    jack_port_t *in_ports[ASIO_MAX_CHANNELS];
+    jack_port_t *out_ports[ASIO_MAX_CHANNELS];
+
+    /* set by prepare, read by the JACK thread */
+    jack_nframes_t frames;
+    UINT32 input_mask, output_mask;
+    float *in_bufs[ASIO_MAX_CHANNELS][2];
+    float *out_bufs[ASIO_MAX_CHANNELS][2];
+    BOOL active;
+
+    /* the cycle handshake, futex words */
+    int running;
+    int ready_seq;          /* bumped by the JACK thread when a cycle is ready */
+    int done_seq;           /* set by the host thread when it has filled the outputs */
+    int served_seq;         /* last cycle handed to the host thread */
+    unsigned int index;     /* buffer half of the cycle being served */
+    unsigned int next_index;
+    UINT64 position, next_position;
+    int flags;
+    int xruns;
+
+    /* following the default devices */
+    pthread_t follow_thread;
+    pthread_mutex_t follow_lock;
+    pthread_cond_t follow_cond;
+    BOOL follow_quit, follow_started;
+    char *linked_in[ASIO_MAX_CHANNELS];
+    char *linked_out[ASIO_MAX_CHANNELS];
+};
+
+static BOOL load_jack(void)
+{
+    /* Ask PipeWire's JACK library by path first: without it a JACK library
+     * that needs its own server could be found. */
+    static const char * const names[] =
+    {
+        "/usr/lib/x86_64-linux-gnu/pipewire-0.3/jack/libjack.so.0",
+        "/usr/lib64/pipewire-0.3/jack/libjack.so.0",
+        "/usr/lib/pipewire-0.3/jack/libjack.so.0",
+        "libjack.so.0",
+    };
+    static void *lib;
+    unsigned int i;
+
+    if (lib) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(names) && !lib; i++)
+        lib = dlopen(names[i], RTLD_NOW | RTLD_LOCAL);
+    if (!lib)
+    {
+        ERR("no JACK library found\n");
+        return FALSE;
+    }
+
+#define DO_FUNC(ret, name, args) \
+    if (!(p##name = dlsym(lib, #name)) && strcmp(#name, "jack_client_real_time_priority")) \
+    { \
+        ERR("%s missing\n", #name); \
+        dlclose(lib); \
+        lib = NULL; \
+        return FALSE; \
+    }
+    JACK_FUNCS
+#undef DO_FUNC
+    return TRUE;
+}
+
+static int futex_wait(int *addr, int val, const struct timespec *timeout)
+{
+    return syscall(SYS_futex, addr, FUTEX_WAIT_PRIVATE, val, timeout, NULL, 0);
+}
+
+static void futex_wake(int *addr)
+{
+    syscall(SYS_futex, addr, FUTEX_WAKE_PRIVATE, 1, NULL, NULL, 0);
+}
+
+static struct asio_client *get_client(UINT64 handle)
+{
+    return (struct asio_client *)(ULONG_PTR)handle;
+}
+
+static int process_cb(jack_nframes_t frames, void *arg)
+{
+    struct asio_client *client = arg;
+    struct timespec timeout, now;
+    long long deadline;
+    unsigned int i, index;
+    int seq;
+
+    if (!__atomic_load_n(&client->running, __ATOMIC_ACQUIRE) || frames != client->frames)
+    {
+        for (i = 0; i < client->outputs; i++)
+            memset(pjack_port_get_buffer(client->out_ports[i], frames), 0, frames * sizeof(float));
+        return 0;
+    }
+
+    index = client->next_index;
+    for (i = 0; i < client->inputs; i++)
+        if (client->input_mask & (1u << i))
+            memcpy(client->in_bufs[i][index], pjack_port_get_buffer(client->in_ports[i], frames),
+                   frames * sizeof(float));
+
+    client->index = index;
+    client->position = client->next_position;
+    seq = client->ready_seq + 1;
+    __atomic_store_n(&client->ready_seq, seq, __ATOMIC_RELEASE);
+    futex_wake(&client->ready_seq);
+
+    /* Give the host one period. Past that the cycle is lost anyway. */
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    deadline = now.tv_sec * 1000000000LL + now.tv_nsec +
+               (long long)frames * 1000000000 / pjack_get_sample_rate(client->jack);
+    for (;;)
+    {
+        int done = __atomic_load_n(&client->done_seq, __ATOMIC_ACQUIRE);
+        long long left;
+
+        if (done == seq) break;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        left = deadline - (now.tv_sec * 1000000000LL + now.tv_nsec);
+        if (left <= 0)
+        {
+            for (i = 0; i < client->outputs; i++)
+                memset(pjack_port_get_buffer(client->out_ports[i], frames), 0, frames * sizeof(float));
+            __atomic_add_fetch(&client->xruns, 1, __ATOMIC_RELAXED);
+            __atomic_or_fetch(&client->flags, ASIO_CYCLE_XRUN, __ATOMIC_RELAXED);
+            goto next;
+        }
+        timeout.tv_sec = left / 1000000000;
+        timeout.tv_nsec = left % 1000000000;
+        futex_wait(&client->done_seq, done, &timeout);
+    }
+
+    for (i = 0; i < client->outputs; i++)
+    {
+        float *out = pjack_port_get_buffer(client->out_ports[i], frames);
+        if (client->output_mask & (1u << i))
+            memcpy(out, client->out_bufs[i][index], frames * sizeof(float));
+        else
+            memset(out, 0, frames * sizeof(float));
+    }
+
+next:
+    client->next_index = index ^ 1;
+    client->next_position += frames;
+    return 0;
+}
+
+static int buffer_size_cb(jack_nframes_t frames, void *arg)
+{
+    struct asio_client *client = arg;
+
+    if (__atomic_load_n(&client->running, __ATOMIC_ACQUIRE) && frames != client->frames)
+    {
+        __atomic_or_fetch(&client->flags, ASIO_CYCLE_RESET, __ATOMIC_RELAXED);
+        futex_wake(&client->ready_seq);
+    }
+    return 0;
+}
+
+static int sample_rate_cb(jack_nframes_t rate, void *arg)
+{
+    struct asio_client *client = arg;
+
+    __atomic_or_fetch(&client->flags, ASIO_CYCLE_RATE, __ATOMIC_RELAXED);
+    return 0;
+}
+
+static void latency_cb(int mode, void *arg)
+{
+    struct asio_client *client = arg;
+
+    __atomic_or_fetch(&client->flags, ASIO_CYCLE_LATENCY, __ATOMIC_RELAXED);
+}
+
+/* Ports of the default output or input, in channel order. PipeWire's JACK
+ * library also answers to "system:playback_N" and "system:capture_N" for
+ * the ports of whatever device is the default right now. */
+static char **default_device_ports(jack_client_t *jack, BOOL capture, unsigned int *count)
+{
+    const char **ports;
+    char **ret;
+    unsigned int n = 0;
+
+    *count = 0;
+    ports = pjack_get_ports(jack, capture ? "^system:capture_" : "^system:playback_", "audio",
+                            capture ? JackPortIsOutput : JackPortIsInput);
+    if (!ports) return NULL;
+    if ((ret = calloc(ASIO_MAX_CHANNELS + 1, sizeof(*ret))))
+        for (n = 0; ports[n] && n < ASIO_MAX_CHANNELS; n++) ret[n] = strdup(ports[n]);
+    pjack_free(ports);
+    *count = n;
+    return ret;
+}
+
+static void free_port_list(char **list)
+{
+    unsigned int i;
+
+    if (!list) return;
+    for (i = 0; list[i]; i++) free(list[i]);
+    free(list);
+}
+
+static void relink(struct asio_client *client, jack_port_t *port, char **linked, const char *want, BOOL capture)
+{
+    const char *ours = pjack_port_name(port);
+
+    if (*linked && want && !strcmp(*linked, want)) return;
+    if (*linked)
+    {
+        if (capture) pjack_disconnect(client->jack, *linked, ours);
+        else pjack_disconnect(client->jack, ours, *linked);
+        free(*linked);
+        *linked = NULL;
+    }
+    if (!want) return;
+    if (!(capture ? pjack_connect(client->jack, want, ours) : pjack_connect(client->jack, ours, want)))
+        *linked = strdup(want);
+}
+
+/* Keep our ports linked to the default devices. Only the links made here
+ * move; links the user made to anything else stay where they are. */
+static void follow_defaults(struct asio_client *client)
+{
+    char **outs, **ins;
+    unsigned int n_out, n_in, i;
+
+    outs = default_device_ports(client->jack, FALSE, &n_out);
+    ins = default_device_ports(client->jack, TRUE, &n_in);
+
+    /* A mono device gets every channel, otherwise channel i goes to port i. */
+    for (i = 0; i < client->outputs; i++)
+        relink(client, client->out_ports[i], &client->linked_out[i],
+               n_out == 1 ? outs[0] : i < n_out ? outs[i] : NULL, FALSE);
+    for (i = 0; i < client->inputs; i++)
+        relink(client, client->in_ports[i], &client->linked_in[i],
+               n_in == 1 ? ins[0] : i < n_in ? ins[i] : NULL, TRUE);
+
+    free_port_list(outs);
+    free_port_list(ins);
+}
+
+static void *follow_thread(void *arg)
+{
+    struct asio_client *client = arg;
+    struct timespec ts;
+
+    pthread_mutex_lock(&client->follow_lock);
+    while (!client->follow_quit)
+    {
+        pthread_mutex_unlock(&client->follow_lock);
+        follow_defaults(client);
+        pthread_mutex_lock(&client->follow_lock);
+
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += 1;
+        while (!client->follow_quit &&
+               pthread_cond_timedwait(&client->follow_cond, &client->follow_lock, &ts) != ETIMEDOUT)
+            ;
+    }
+    pthread_mutex_unlock(&client->follow_lock);
+    return NULL;
+}
+
+static unsigned int default_channels(jack_client_t *jack, BOOL capture)
+{
+    unsigned int n;
+
+    free_port_list(default_device_ports(jack, capture, &n));
+    return n;
+}
+
+static NTSTATUS asio_open(void *args)
+{
+    struct asio_open_params *params = args;
+    struct asio_client *client;
+    char name[16];
+    unsigned int i;
+    int status;
+
+    params->result = STATUS_UNSUCCESSFUL;
+    if (!load_jack()) return STATUS_SUCCESS;
+    if (!(client = calloc(1, sizeof(*client)))) return STATUS_SUCCESS;
+
+    /* The buffer size is forced on the graph when the host creates its
+     * buffers, so nothing to ask for here. */
+    if (!(client->jack = pjack_client_open(params->client_name, JackNoStartServer, &status)))
+    {
+        WARN("could not open a client, status %#x\n", status);
+        free(client);
+        return STATUS_SUCCESS;
+    }
+
+    client->inputs = params->inputs;
+    client->outputs = params->outputs;
+    if (!client->inputs) client->inputs = max(2, default_channels(client->jack, TRUE));
+    if (!client->outputs) client->outputs = max(2, default_channels(client->jack, FALSE));
+    client->inputs = min(client->inputs, ASIO_MAX_CHANNELS);
+    client->outputs = min(client->outputs, ASIO_MAX_CHANNELS);
+
+    for (i = 0; i < client->inputs; i++)
+    {
+        snprintf(name, sizeof(name), "in_%u", i + 1);
+        client->in_ports[i] = pjack_port_register(client->jack, name, JACK_DEFAULT_AUDIO_TYPE, JackPortIsInput, 0);
+    }
+    for (i = 0; i < client->outputs; i++)
+    {
+        snprintf(name, sizeof(name), "out_%u", i + 1);
+        client->out_ports[i] = pjack_port_register(client->jack, name, JACK_DEFAULT_AUDIO_TYPE, JackPortIsOutput, 0);
+    }
+
+    pjack_set_process_callback(client->jack, process_cb, client);
+    pjack_set_buffer_size_callback(client->jack, buffer_size_cb, client);
+    pjack_set_sample_rate_callback(client->jack, sample_rate_cb, client);
+    pjack_set_latency_callback(client->jack, latency_cb, client);
+    pthread_mutex_init(&client->follow_lock, NULL);
+    pthread_cond_init(&client->follow_cond, NULL);
+
+    params->handle = (UINT64)(ULONG_PTR)client;
+    params->sample_rate = pjack_get_sample_rate(client->jack);
+    params->current_size = pjack_get_buffer_size(client->jack);
+    params->inputs = client->inputs;
+    params->outputs = client->outputs;
+    params->result = STATUS_SUCCESS;
+    TRACE("client %p: %u in, %u out, %u Hz, %u frames\n", client, client->inputs, client->outputs,
+          params->sample_rate, params->current_size);
+    return STATUS_SUCCESS;
+}
+
+static void stop_following(struct asio_client *client)
+{
+    if (!client->follow_started) return;
+    pthread_mutex_lock(&client->follow_lock);
+    client->follow_quit = TRUE;
+    pthread_cond_signal(&client->follow_cond);
+    pthread_mutex_unlock(&client->follow_lock);
+    pthread_join(client->follow_thread, NULL);
+    client->follow_started = FALSE;
+}
+
+static void unlock_buffers(struct asio_client *client)
+{
+    unsigned int i;
+
+    for (i = 0; i < ASIO_MAX_CHANNELS; i++)
+    {
+        if (client->in_bufs[i][0]) munlock(client->in_bufs[i][0], client->frames * sizeof(float) * 2);
+        if (client->out_bufs[i][0]) munlock(client->out_bufs[i][0], client->frames * sizeof(float) * 2);
+    }
+    memset(client->in_bufs, 0, sizeof(client->in_bufs));
+    memset(client->out_bufs, 0, sizeof(client->out_bufs));
+}
+
+static NTSTATUS asio_release(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+
+    __atomic_store_n(&client->running, 0, __ATOMIC_RELEASE);
+    futex_wake(&client->ready_seq);
+    stop_following(client);
+    if (client->active)
+    {
+        unsigned int i;
+
+        pjack_deactivate(client->jack);
+        client->active = FALSE;
+        for (i = 0; i < ASIO_MAX_CHANNELS; i++)
+        {
+            free(client->linked_in[i]);
+            free(client->linked_out[i]);
+            client->linked_in[i] = client->linked_out[i] = NULL;
+        }
+    }
+    unlock_buffers(client);
+    client->frames = 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_close(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+
+    asio_release(args);
+    pjack_client_close(client->jack);
+    pthread_mutex_destroy(&client->follow_lock);
+    pthread_cond_destroy(&client->follow_cond);
+    free(client);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_get_info(void *args)
+{
+    struct asio_info_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+    jack_latency_range_t range;
+
+    params->sample_rate = pjack_get_sample_rate(client->jack);
+    params->buffer_size = pjack_get_buffer_size(client->jack);
+    params->inputs = client->inputs;
+    params->outputs = client->outputs;
+    pjack_port_get_latency_range(client->in_ports[0], JackCaptureLatency, &range);
+    params->input_latency = range.max;
+    pjack_port_get_latency_range(client->out_ports[0], JackPlaybackLatency, &range);
+    params->output_latency = range.max;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_prepare(void *args)
+{
+    struct asio_prepare_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+    unsigned int i, waited;
+
+    params->result = STATUS_UNSUCCESSFUL;
+    if (client->active) return STATUS_SUCCESS;
+
+    /* Before activation the library reports the latency we asked for, not
+     * the graph's quantum, so always force it. */
+    if (pjack_set_buffer_size(client->jack, params->frames))
+    {
+        WARN("could not set the buffer size to %u\n", params->frames);
+        return STATUS_SUCCESS;
+    }
+
+    client->frames = params->frames;
+    client->input_mask = params->input_mask;
+    client->output_mask = params->output_mask;
+    for (i = 0; i < ASIO_MAX_CHANNELS; i++)
+    {
+        client->in_bufs[i][0] = (float *)(ULONG_PTR)params->inputs[i][0];
+        client->in_bufs[i][1] = (float *)(ULONG_PTR)params->inputs[i][1];
+        client->out_bufs[i][0] = (float *)(ULONG_PTR)params->outputs[i][0];
+        client->out_bufs[i][1] = (float *)(ULONG_PTR)params->outputs[i][1];
+        /* both halves are one block; keep it out of swap for the RT thread */
+        if (client->in_bufs[i][0]) mlock(client->in_bufs[i][0], client->frames * sizeof(float) * 2);
+        if (client->out_bufs[i][0]) mlock(client->out_bufs[i][0], client->frames * sizeof(float) * 2);
+    }
+    client->running = 0;
+    client->next_index = 0;
+    client->next_position = 0;
+    client->flags = 0;
+    client->xruns = 0;
+
+    if (pjack_activate(client->jack))
+    {
+        WARN("could not activate the client\n");
+        unlock_buffers(client);
+        client->frames = 0;
+        return STATUS_SUCCESS;
+    }
+    client->active = TRUE;
+
+    /* The new quantum takes a moment to reach the graph. */
+    for (waited = 0; waited < 1000 && pjack_get_buffer_size(client->jack) != params->frames; waited += 10)
+        usleep(10000);
+    if (pjack_get_buffer_size(client->jack) != params->frames)
+        WARN("graph runs at %u frames, not %u\n", pjack_get_buffer_size(client->jack), params->frames);
+
+    follow_defaults(client);
+    client->follow_quit = FALSE;
+    if (!pthread_create(&client->follow_thread, NULL, follow_thread, client))
+        client->follow_started = TRUE;
+
+    params->result = STATUS_SUCCESS;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_run(void *args)
+{
+    struct asio_run_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+
+    if (params->running)
+    {
+        client->served_seq = client->ready_seq;
+        client->done_seq = client->ready_seq;
+        client->xruns = 0;
+        client->flags = 0;
+        __atomic_store_n(&client->running, 1, __ATOMIC_RELEASE);
+    }
+    else
+    {
+        __atomic_store_n(&client->running, 0, __ATOMIC_RELEASE);
+        /* release a JACK thread that waits for this host thread, and the
+         * host thread itself */
+        __atomic_store_n(&client->done_seq, client->ready_seq, __ATOMIC_RELEASE);
+        futex_wake(&client->done_seq);
+        futex_wake(&client->ready_seq);
+    }
+    return STATUS_SUCCESS;
+}
+
+static BOOL load_dbus(void)
+{
+    static void *lib;
+
+    if (lib) return TRUE;
+    if (!(lib = dlopen("libdbus-1.so.3", RTLD_NOW | RTLD_LOCAL))) return FALSE;
+#define DO_FUNC(ret, name, args) \
+    if (!(p##name = dlsym(lib, #name))) { dlclose(lib); lib = NULL; return FALSE; }
+    DBUS_FUNCS
+#undef DO_FUNC
+    return TRUE;
+}
+
+/* Without RLIMIT_RTPRIO a desktop user gets realtime threads through
+ * RealtimeKit, which wants the kernel thread id. PipeWire's own library
+ * only does this for threads it started itself. */
+static BOOL rtkit_make_realtime(UINT32 prio)
+{
+    UINT64 tid = syscall(SYS_gettid);
+    void *conn, *msg, *reply = NULL;
+    DBusError err;
+
+    if (!load_dbus()) return FALSE;
+    pdbus_error_init(&err);
+    if (!(conn = pdbus_bus_get_private(DBUS_BUS_SYSTEM, &err)))
+    {
+        pdbus_error_free(&err);
+        return FALSE;
+    }
+    if ((msg = pdbus_message_new_method_call("org.freedesktop.RealtimeKit1", "/org/freedesktop/RealtimeKit1",
+                                             "org.freedesktop.RealtimeKit1", "MakeThreadRealtime")))
+    {
+        if (pdbus_message_append_args(msg, DBUS_TYPE_UINT64, &tid, DBUS_TYPE_UINT32, &prio, DBUS_TYPE_INVALID))
+            reply = pdbus_connection_send_with_reply_and_block(conn, msg, 1000, &err);
+        pdbus_message_unref(msg);
+    }
+    if (reply) pdbus_message_unref(reply);
+    else
+    {
+        if (err.message) WARN("RealtimeKit: %s\n", err.message);
+        pdbus_error_free(&err);
+    }
+    pdbus_connection_close(conn);
+    pdbus_connection_unref(conn);
+    return reply != NULL;
+}
+
+/* RT priority for the host thread, which does the actual audio work. */
+static NTSTATUS asio_realtime(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+    struct sched_param param = { 0 };
+    int prio = 0;
+
+    if (pjack_client_real_time_priority) prio = pjack_client_real_time_priority(client->jack);
+    if (prio <= 0) prio = 20;
+    else if (prio > 1) prio--;   /* just below the graph's own thread */
+
+    param.sched_priority = prio;
+    if (!pthread_setschedparam(pthread_self(), SCHED_FIFO | SCHED_RESET_ON_FORK, &param))
+        return STATUS_SUCCESS;
+    /* RealtimeKit allows 20 at most by default */
+    if (rtkit_make_realtime(min(prio, 20)))
+        return STATUS_SUCCESS;
+    WARN("no realtime priority for the host thread\n");
+    return STATUS_UNSUCCESSFUL;
+}
+
+static NTSTATUS asio_cycle(void *args)
+{
+    struct asio_cycle_params *params = args;
+    struct asio_client *client = get_client(params->handle);
+    struct timespec timeout = { 0, 100000000 };
+    int ready;
+
+    if (params->done)
+    {
+        __atomic_store_n(&client->done_seq, client->served_seq, __ATOMIC_RELEASE);
+        futex_wake(&client->done_seq);
+    }
+
+    for (;;)
+    {
+        params->flags = __atomic_exchange_n(&client->flags, 0, __ATOMIC_ACQ_REL);
+        if (!__atomic_load_n(&client->running, __ATOMIC_ACQUIRE)) params->flags |= ASIO_CYCLE_STOP;
+        if (params->flags & (ASIO_CYCLE_STOP | ASIO_CYCLE_RESET))
+        {
+            params->index = 0;
+            params->position = 0;
+            return STATUS_SUCCESS;
+        }
+        ready = __atomic_load_n(&client->ready_seq, __ATOMIC_ACQUIRE);
+        if (ready != client->served_seq) break;
+        if (params->flags) return STATUS_SUCCESS;
+        futex_wait(&client->ready_seq, ready, &timeout);
+    }
+
+    client->served_seq = ready;
+    params->flags |= ASIO_CYCLE_READY;
+    params->index = client->index;
+    params->position = client->position;
+    params->sample_rate = pjack_get_sample_rate(client->jack);
+    params->xruns = __atomic_load_n(&client->xruns, __ATOMIC_RELAXED);
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    asio_open,
+    asio_close,
+    asio_get_info,
+    asio_prepare,
+    asio_release,
+    asio_run,
+    asio_realtime,
+    asio_cycle,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_asio_funcs_count);
+
+#ifdef _WIN64
+
+/* The parameter structures have the same layout for 32-bit callers. */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    asio_open,
+    asio_close,
+    asio_get_info,
+    asio_prepare,
+    asio_release,
+    asio_run,
+    asio_realtime,
+    asio_cycle,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_asio_funcs_count);
+
+#endif
