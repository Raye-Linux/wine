+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "mmsystem.h"
+#include "objbase.h"
+#include "olectl.h"
+#include "wine/asm.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+#include "resource.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(asio);
+
+#define UNIX_CALL(func, params) WINE_UNIX_CALL(unix_ ## func, params)
+
+static const CLSID CLSID_RayeASIO = {0xe4491bcf, 0x5a31, 0x4977, {0x92, 0xba, 0xeb, 0x3c, 0xad, 0x66, 0xe8, 0x3d}};
+static const WCHAR clsid_string[] = L"{E4491BCF-5A31-4977-92BA-EB3CAD66E83D}";
+static const WCHAR driver_name[] = L"Raye ASIO";
+static const WCHAR settings_key[] = L"Software\\Raye\\ASIO";
+
+#define MIN_BUFFER_SIZE       32
+#define MAX_BUFFER_SIZE       2048
+#define DEFAULT_BUFFER_SIZE   256
+
+/* ASIO's own types and constants, from its public interface. */
+#define ASE_OK                0
+#define ASE_SUCCESS           0x3f4847a0
+#define ASE_NotPresent        (-1000)
+#define ASE_HWMalfunction     (-999)
+#define ASE_InvalidParameter  (-998)
+#define ASE_InvalidMode       (-997)
+#define ASE_NoClock           (-995)
+#define ASE_NoMemory          (-994)
+
+#define ASIOSTFloat32LSB      19
+
+enum
+{
+    kAsioSelectorSupported = 1,
+    kAsioEngineVersion,
+    kAsioResetRequest,
+    kAsioBufferSizeChange,
+    kAsioResyncRequest,
+    kAsioLatenciesChanged,
+    kAsioSupportsTimeInfo,
+    kAsioSupportsTimeCode,
+    kAsioMMCCommand,
+    kAsioSupportsInputMonitor,
+    kAsioSupportsInputGain,
+    kAsioSupportsInputMeter,
+    kAsioSupportsOutputGain,
+    kAsioSupportsOutputMeter,
+    kAsioOverload,
+};
+
+enum
+{
+    kAsioEnableTimeCodeRead = 1,
+    kAsioDisableTimeCodeRead,
+    kAsioSetInputMonitor,
+    kAsioTransport,
+    kAsioSetInputGain,
+    kAsioGetInputMeter,
+    kAsioSetOutputGain,
+    kAsioGetOutputMeter,
+    kAsioCanInputMonitor,
+    kAsioCanTimeInfo,
+    kAsioCanTimeCode,
+};
+#define kAsioCanReportOverload 0x24042012
+
+struct asio_samples { ULONG hi, lo; };
+
+struct asio_time
+{
+    LONG reserved[4];
+    struct
+    {
+        double speed;
+        struct asio_samples system_time;
+        struct asio_samples sample_position;
+        double sample_rate;
+        ULONG flags;
+        char reserved[12];
+    } time_info;
+    struct
+    {
+        double speed;
+        struct asio_samples time_code_samples;
+        ULONG flags;
+        char future[64];
+    } time_code;
+};
+
+#define kSystemTimeValid      0x1
+#define kSamplePositionValid  0x2
+#define kSampleRateValid      0x4
+
+struct asio_callbacks
+{
+    void (CDECL *buffer_switch)(LONG index, LONG direct_process);
+    void (CDECL *sample_rate_changed)(double rate);
+    LONG (CDECL *message)(LONG selector, LONG value, void *message, double *opt);
+    struct asio_time *(CDECL *buffer_switch_time_info)(struct asio_time *params, LONG index, LONG direct_process);
+};
+
+struct asio_buffer_info
+{
+    LONG is_input;
+    LONG channel;
+    void *buffers[2];
+};
+
+struct asio_channel_info
+{
+    LONG channel;
+    LONG is_input;
+    LONG is_active;
+    LONG group;
+    LONG type;
+    char name[32];
+};
+
+struct asio_clock_source
+{
+    LONG index;
+    LONG channel;
+    LONG group;
+    LONG is_current;
+    char name[32];
+};
+
+enum driver_state { STATE_LOADED, STATE_INITIALIZED, STATE_PREPARED, STATE_RUNNING };
+
+struct asio_driver
+{
+    const void * const *vtbl;
+    LONG ref;
+
+    enum driver_state state;
+    UINT64 handle;
+    HWND window;
+    char error[128];
+
+    UINT32 sample_rate;
+    UINT32 inputs, outputs;
+    UINT32 frames;          /* size of the host's buffers */
+    UINT32 preferred;
+    UINT32 input_mask, output_mask;
+    float *buffers;
+    float *in_bufs[ASIO_MAX_CHANNELS], *out_bufs[ASIO_MAX_CHANNELS];
+
+    struct asio_callbacks *callbacks;
+    BOOL time_info;
+    BOOL report_overload;
+    struct asio_time time;
+    struct asio_samples position, stamp;
+
+    HANDLE thread, thread_ready, thread_go;
+    DWORD thread_id;
+};
+
+static HINSTANCE instance;
+
+static void to_asio_samples(UINT64 value, struct asio_samples *out)
+{
+    out->hi = value >> 32;
+    out->lo = (ULONG)value;
+}
+
+static DWORD read_setting(const WCHAR *name, DWORD def)
+{
+    DWORD value, size = sizeof(value);
+
+    if (RegGetValueW(HKEY_CURRENT_USER, settings_key, name, RRF_RT_REG_DWORD, NULL, &value, &size))
+        return def;
+    return value;
+}
+
+static BOOL valid_buffer_size(UINT32 frames)
+{
+    return frames >= MIN_BUFFER_SIZE && frames <= MAX_BUFFER_SIZE && !(frames & (frames - 1));
+}
+
+static void load_string(UINT id, WCHAR *buf, int len)
+{
+    if (!LoadStringW(instance, id, buf, len)) buf[0] = 0;
+}
+
+static LONG send_message(struct asio_driver *driver, LONG selector, LONG value)
+{
+    if (!driver->callbacks || !driver->callbacks->message) return 0;
+    return driver->callbacks->message(selector, value, NULL, NULL);
+}
+
+static HRESULT WINAPI driver_QueryInterface(struct asio_driver *driver, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p\n", driver, debugstr_guid(riid), obj);
+
+    if (!obj) return E_POINTER;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &CLSID_RayeASIO))
+    {
+        InterlockedIncrement(&driver->ref);
+        *obj = driver;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI driver_AddRef(struct asio_driver *driver)
+{
+    return InterlockedIncrement(&driver->ref);
+}
+
+static LONG __thiscall asio_dispose_buffers(struct asio_driver *driver);
+
+static ULONG WINAPI driver_Release(struct asio_driver *driver)
+{
+    ULONG ref = InterlockedDecrement(&driver->ref);
+    struct asio_handle_params params;
+
+    if (ref) return ref;
+
+    asio_dispose_buffers(driver);
+    if (driver->handle)
+    {
+        params.handle = driver->handle;
+        UNIX_CALL(asio_close, &params);
+    }
+    free(driver);
+    return 0;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_init, 8)
+static LONG __thiscall asio_init(struct asio_driver *driver, void *sys_ref)
+{
+    struct asio_open_params params = { 0 };
+    WCHAR path[MAX_PATH], *name, *dot;
+
+    TRACE("%p, %p\n", driver, sys_ref);
+
+    if (driver->state != STATE_LOADED) return 1;
+    driver->window = sys_ref;
+
+    GetModuleFileNameW(NULL, path, ARRAY_SIZE(path));
+    name = wcsrchr(path, '\\');
+    name = name ? name + 1 : path;
+    if ((dot = wcsrchr(name, '.'))) *dot = 0;
+    WideCharToMultiByte(CP_UTF8, 0, name, -1, params.client_name, sizeof(params.client_name), NULL, NULL);
+
+    driver->preferred = read_setting(L"Buffer size", DEFAULT_BUFFER_SIZE);
+    if (!valid_buffer_size(driver->preferred)) driver->preferred = DEFAULT_BUFFER_SIZE;
+    params.inputs = min(read_setting(L"Inputs", 0), ASIO_MAX_CHANNELS);
+    params.outputs = min(read_setting(L"Outputs", 0), ASIO_MAX_CHANNELS);
+
+    if (UNIX_CALL(asio_open, &params) || params.result)
+    {
+        WCHAR msg[128];
+
+        load_string(IDS_NO_SERVER, msg, ARRAY_SIZE(msg));
+        WideCharToMultiByte(CP_ACP, 0, msg, -1, driver->error, sizeof(driver->error), NULL, NULL);
+        return 0;
+    }
+
+    driver->handle = params.handle;
+    driver->sample_rate = params.sample_rate;
+    driver->inputs = params.inputs;
+    driver->outputs = params.outputs;
+    driver->state = STATE_INITIALIZED;
+    TRACE("%u inputs, %u outputs, %u Hz, graph at %u frames\n", driver->inputs, driver->outputs,
+          driver->sample_rate, params.current_size);
+    return 1;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_driver_name, 8)
+static void __thiscall asio_get_driver_name(struct asio_driver *driver, char *name)
+{
+    WideCharToMultiByte(CP_ACP, 0, driver_name, -1, name, 32, NULL, NULL);
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_driver_version, 4)
+static LONG __thiscall asio_get_driver_version(struct asio_driver *driver)
+{
+    return 1;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_error_message, 8)
+static void __thiscall asio_get_error_message(struct asio_driver *driver, char *string)
+{
+    /* the host's buffer is 124 bytes */
+    lstrcpynA(string, driver->error, 124);
+}
+
+static DWORD WINAPI callback_thread(void *arg)
+{
+    struct asio_driver *driver = arg;
+    struct asio_cycle_params params = { 0 };
+    UINT32 xruns = 0;
+    DWORD ms;
+
+    SetThreadDescription(GetCurrentThread(), L"asio_callback");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    params.handle = driver->handle;
+    UNIX_CALL(asio_realtime, &params.handle);
+    SignalObjectAndWait(driver->thread_ready, driver->thread_go, INFINITE, FALSE);
+
+    for (;;)
+    {
+        UNIX_CALL(asio_cycle, &params);
+        params.done = 0;
+
+        if (params.flags & ASIO_CYCLE_STOP) break;
+        if (params.flags & ASIO_CYCLE_RESET)
+        {
+            TRACE("buffer size changed, asking the host to start over\n");
+            if (send_message(driver, kAsioSelectorSupported, kAsioResetRequest))
+                send_message(driver, kAsioResetRequest, 0);
+            continue;
+        }
+        if (params.flags & ASIO_CYCLE_LATENCY && send_message(driver, kAsioSelectorSupported, kAsioLatenciesChanged))
+            send_message(driver, kAsioLatenciesChanged, 0);
+        if (params.flags & ASIO_CYCLE_RATE && params.sample_rate != driver->sample_rate)
+        {
+            driver->sample_rate = params.sample_rate;
+            if (driver->callbacks->sample_rate_changed)
+                driver->callbacks->sample_rate_changed(driver->sample_rate);
+        }
+        if (params.xruns != xruns)
+        {
+            WARN("%u cycles late so far\n", params.xruns);
+            if (driver->report_overload) send_message(driver, kAsioOverload, 0);
+            xruns = params.xruns;
+        }
+        if (!(params.flags & ASIO_CYCLE_READY)) continue;
+
+        ms = timeGetTime();
+        to_asio_samples(params.position, &driver->position);
+        to_asio_samples((UINT64)ms * 1000000, &driver->stamp);
+
+        if (driver->time_info)
+        {
+            driver->time.time_info.speed = 1.0;
+            driver->time.time_info.system_time = driver->stamp;
+            driver->time.time_info.sample_position = driver->position;
+            driver->time.time_info.sample_rate = driver->sample_rate;
+            driver->time.time_info.flags = kSystemTimeValid | kSamplePositionValid | kSampleRateValid;
+            driver->callbacks->buffer_switch_time_info(&driver->time, params.index, TRUE);
+        }
+        else
+            driver->callbacks->buffer_switch(params.index, TRUE);
+        params.done = 1;
+    }
+    return 0;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_start, 4)
+static LONG __thiscall asio_start(struct asio_driver *driver)
+{
+    struct asio_run_params params = { driver->handle, 1 };
+
+    TRACE("%p\n", driver);
+
+    if (driver->state != STATE_PREPARED) return ASE_NotPresent;
+
+    memset(driver->buffers, 0, (driver->inputs + driver->outputs) * 2 * driver->frames * sizeof(float));
+    driver->position.hi = driver->position.lo = 0;
+    /* The thread gets its priority before the first cycle waits for it. */
+    driver->thread_ready = CreateEventW(NULL, FALSE, FALSE, NULL);
+    driver->thread_go = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!(driver->thread = CreateThread(NULL, 0, callback_thread, driver, 0, &driver->thread_id)))
+    {
+        CloseHandle(driver->thread_ready);
+        CloseHandle(driver->thread_go);
+        return ASE_HWMalfunction;
+    }
+    WaitForSingleObject(driver->thread_ready, INFINITE);
+    UNIX_CALL(asio_run, &params);
+    SetEvent(driver->thread_go);
+    CloseHandle(driver->thread_ready);
+    driver->state = STATE_RUNNING;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_stop, 4)
+static LONG __thiscall asio_stop(struct asio_driver *driver)
+{
+    struct asio_run_params params = { driver->handle, 0 };
+
+    TRACE("%p\n", driver);
+
+    if (driver->state != STATE_RUNNING) return ASE_NotPresent;
+
+    UNIX_CALL(asio_run, &params);
+    /* A host may stop from inside its buffer switch. */
+    if (GetCurrentThreadId() != driver->thread_id)
+        WaitForSingleObject(driver->thread, INFINITE);
+    CloseHandle(driver->thread);
+    CloseHandle(driver->thread_go);
+    driver->thread = NULL;
+    driver->thread_id = 0;
+    driver->state = STATE_PREPARED;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_channels, 12)
+static LONG __thiscall asio_get_channels(struct asio_driver *driver, LONG *inputs, LONG *outputs)
+{
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    if (!inputs || !outputs) return ASE_InvalidParameter;
+    *inputs = driver->inputs;
+    *outputs = driver->outputs;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_latencies, 12)
+static LONG __thiscall asio_get_latencies(struct asio_driver *driver, LONG *input, LONG *output)
+{
+    struct asio_info_params params = { driver->handle };
+    UINT32 frames;
+
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    if (!input || !output) return ASE_InvalidParameter;
+
+    UNIX_CALL(asio_get_info, &params);
+    frames = driver->frames ? driver->frames : driver->preferred;
+    *input = frames + params.input_latency;
+    *output = frames + params.output_latency;
+    TRACE("input %d, output %d\n", (int)*input, (int)*output);
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_buffer_size, 20)
+static LONG __thiscall asio_get_buffer_size(struct asio_driver *driver, LONG *min_size, LONG *max_size,
+                                        LONG *preferred, LONG *granularity)
+{
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    if (!min_size || !max_size || !preferred || !granularity) return ASE_InvalidParameter;
+
+    *min_size = MIN_BUFFER_SIZE;
+    *max_size = MAX_BUFFER_SIZE;
+    *preferred = driver->preferred;
+    *granularity = -1;  /* powers of two */
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_can_sample_rate, 12)
+static LONG __thiscall asio_can_sample_rate(struct asio_driver *driver, double rate)
+{
+    TRACE("%f, running at %u\n", rate, driver->sample_rate);
+
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    return rate == driver->sample_rate ? ASE_OK : ASE_NoClock;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_sample_rate, 8)
+static LONG __thiscall asio_get_sample_rate(struct asio_driver *driver, double *rate)
+{
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    if (!rate) return ASE_InvalidParameter;
+    *rate = driver->sample_rate;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_set_sample_rate, 12)
+static LONG __thiscall asio_set_sample_rate(struct asio_driver *driver, double rate)
+{
+    TRACE("%f, running at %u\n", rate, driver->sample_rate);
+
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    /* 0 asks for an external clock, which is the graph's anyway */
+    return rate == 0.0 || rate == driver->sample_rate ? ASE_OK : ASE_NoClock;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_clock_sources, 12)
+static LONG __thiscall asio_get_clock_sources(struct asio_driver *driver, struct asio_clock_source *clocks, LONG *count)
+{
+    WCHAR name[32];
+
+    if (!clocks || !count) return ASE_InvalidParameter;
+
+    load_string(IDS_INTERNAL, name, ARRAY_SIZE(name));
+    clocks->index = 0;
+    clocks->channel = -1;
+    clocks->group = -1;
+    clocks->is_current = 1;
+    WideCharToMultiByte(CP_ACP, 0, name, -1, clocks->name, sizeof(clocks->name), NULL, NULL);
+    *count = 1;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_set_clock_source, 8)
+static LONG __thiscall asio_set_clock_source(struct asio_driver *driver, LONG index)
+{
+    return index ? ASE_InvalidParameter : ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_sample_position, 12)
+static LONG __thiscall asio_get_sample_position(struct asio_driver *driver, struct asio_samples *position,
+                                            struct asio_samples *stamp)
+{
+    if (driver->state < STATE_PREPARED) return ASE_NotPresent;
+    if (!position || !stamp) return ASE_InvalidParameter;
+    *position = driver->position;
+    *stamp = driver->stamp;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_get_channel_info, 8)
+static LONG __thiscall asio_get_channel_info(struct asio_driver *driver, struct asio_channel_info *info)
+{
+    WCHAR format[32], name[32];
+
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    if (!info || info->channel < 0 || info->channel >= (info->is_input ? driver->inputs : driver->outputs))
+        return ASE_InvalidParameter;
+
+    info->is_active = !!((info->is_input ? driver->input_mask : driver->output_mask) & (1u << info->channel));
+    info->group = 0;
+    info->type = ASIOSTFloat32LSB;
+    load_string(info->is_input ? IDS_INPUT : IDS_OUTPUT, format, ARRAY_SIZE(format));
+    swprintf(name, ARRAY_SIZE(name), format, info->channel + 1);
+    WideCharToMultiByte(CP_ACP, 0, name, -1, info->name, sizeof(info->name), NULL, NULL);
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_create_buffers, 20)
+static LONG __thiscall asio_create_buffers(struct asio_driver *driver, struct asio_buffer_info *info,
+                                       LONG count, LONG frames, struct asio_callbacks *callbacks)
+{
+    struct asio_prepare_params params = { driver->handle };
+    UINT32 in_mask = 0, out_mask = 0;
+    unsigned int i;
+    float *buf;
+
+    TRACE("%p, %p, %d, %d, %p\n", driver, info, (int)count, (int)frames, callbacks);
+
+    if (driver->state != STATE_INITIALIZED) return ASE_InvalidMode;
+    if (!info || !callbacks || count <= 0) return ASE_InvalidParameter;
+    if (!valid_buffer_size(frames))
+    {
+        WARN("buffer size %d refused\n", (int)frames);
+        return ASE_InvalidMode;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        UINT32 *mask = info[i].is_input ? &in_mask : &out_mask;
+
+        if (info[i].channel < 0 || info[i].channel >= (info[i].is_input ? driver->inputs : driver->outputs) ||
+            *mask & (1u << info[i].channel))
+            return ASE_InvalidParameter;
+        *mask |= 1u << info[i].channel;
+    }
+
+    /* Each channel gets both halves in one run, inputs first. */
+    if (!(driver->buffers = VirtualAlloc(NULL, (driver->inputs + driver->outputs) * 2 * frames * sizeof(float),
+                                         MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)))
+        return ASE_NoMemory;
+    buf = driver->buffers;
+    for (i = 0; i < driver->inputs; i++, buf += 2 * frames) driver->in_bufs[i] = buf;
+    for (i = 0; i < driver->outputs; i++, buf += 2 * frames) driver->out_bufs[i] = buf;
+
+    for (i = 0; i < count; i++)
+    {
+        float *start = info[i].is_input ? driver->in_bufs[info[i].channel] : driver->out_bufs[info[i].channel];
+
+        info[i].buffers[0] = start;
+        info[i].buffers[1] = start + frames;
+        if (info[i].is_input)
+        {
+            params.inputs[info[i].channel][0] = (ULONG_PTR)start;
+            params.inputs[info[i].channel][1] = (ULONG_PTR)(start + frames);
+        }
+        else
+        {
+            params.outputs[info[i].channel][0] = (ULONG_PTR)start;
+            params.outputs[info[i].channel][1] = (ULONG_PTR)(start + frames);
+        }
+    }
+
+    driver->callbacks = callbacks;
+    driver->frames = frames;
+    driver->input_mask = in_mask;
+    driver->output_mask = out_mask;
+    driver->time_info = callbacks->buffer_switch_time_info && send_message(driver, kAsioSupportsTimeInfo, 0);
+    driver->report_overload = send_message(driver, kAsioSelectorSupported, kAsioOverload);
+    memset(&driver->time, 0, sizeof(driver->time));
+
+    params.frames = frames;
+    params.input_mask = in_mask;
+    params.output_mask = out_mask;
+    if (UNIX_CALL(asio_prepare, &params) || params.result)
+    {
+        VirtualFree(driver->buffers, 0, MEM_RELEASE);
+        driver->buffers = NULL;
+        driver->callbacks = NULL;
+        driver->frames = 0;
+        driver->input_mask = driver->output_mask = 0;
+        return ASE_HWMalfunction;
+    }
+
+    driver->state = STATE_PREPARED;
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_dispose_buffers, 4)
+static LONG __thiscall asio_dispose_buffers(struct asio_driver *driver)
+{
+    struct asio_handle_params params = { driver->handle };
+
+    TRACE("%p\n", driver);
+
+    if (driver->state == STATE_RUNNING) asio_stop(driver);
+    if (driver->state != STATE_PREPARED) return ASE_InvalidMode;
+
+    UNIX_CALL(asio_release, &params);
+    VirtualFree(driver->buffers, 0, MEM_RELEASE);
+    driver->buffers = NULL;
+    driver->callbacks = NULL;
+    driver->frames = 0;
+    driver->input_mask = driver->output_mask = 0;
+    driver->state = STATE_INITIALIZED;
+    return ASE_OK;
+}
+
+static INT_PTR CALLBACK panel_proc(HWND dialog, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct asio_driver *driver;
+    WCHAR format[64], text[96], ms[16], decimal[4];
+    UINT32 frames, tenths;
+    LRESULT item;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        driver = (struct asio_driver *)lparam;
+        SetWindowLongPtrW(dialog, DWLP_USER, lparam);
+        if (!GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_SDECIMAL, decimal, ARRAY_SIZE(decimal)))
+            lstrcpyW(decimal, L".");
+        load_string(IDS_SAMPLES, format, ARRAY_SIZE(format));
+        for (frames = 64; frames <= 1024; frames *= 2)
+        {
+            tenths = (frames * 10000 + driver->sample_rate / 2) / driver->sample_rate;
+            swprintf(ms, ARRAY_SIZE(ms), L"%u%s%u", tenths / 10, decimal, tenths % 10);
+            swprintf(text, ARRAY_SIZE(text), format, frames, ms);
+            item = SendDlgItemMessageW(dialog, IDC_BUFFER, CB_ADDSTRING, 0, (LPARAM)text);
+            SendDlgItemMessageW(dialog, IDC_BUFFER, CB_SETITEMDATA, item, frames);
+            if (frames == driver->preferred)
+                SendDlgItemMessageW(dialog, IDC_BUFFER, CB_SETCURSEL, item, 0);
+        }
+        load_string(IDS_RATE, format, ARRAY_SIZE(format));
+        swprintf(text, ARRAY_SIZE(text), format, driver->sample_rate);
+        SetDlgItemTextW(dialog, IDC_RATE, text);
+        return TRUE;
+
+    case WM_COMMAND:
+        if (LOWORD(wparam) == IDOK)
+        {
+            driver = (struct asio_driver *)GetWindowLongPtrW(dialog, DWLP_USER);
+            item = SendDlgItemMessageW(dialog, IDC_BUFFER, CB_GETCURSEL, 0, 0);
+            if (item != CB_ERR)
+            {
+                frames = SendDlgItemMessageW(dialog, IDC_BUFFER, CB_GETITEMDATA, item, 0);
+                if (frames != driver->preferred)
+                {
+                    driver->preferred = frames;
+                    RegSetKeyValueW(HKEY_CURRENT_USER, settings_key, L"Buffer size", REG_DWORD,
+                                    &frames, sizeof(frames));
+                    if (send_message(driver, kAsioSelectorSupported, kAsioResetRequest))
+                        send_message(driver, kAsioResetRequest, 0);
+                }
+            }
+            EndDialog(dialog, IDOK);
+            return TRUE;
+        }
+        if (LOWORD(wparam) == IDCANCEL)
+        {
+            EndDialog(dialog, IDCANCEL);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_control_panel, 4)
+static LONG __thiscall asio_control_panel(struct asio_driver *driver)
+{
+    if (driver->state == STATE_LOADED) return ASE_NotPresent;
+    DialogBoxParamW(instance, MAKEINTRESOURCEW(IDD_PANEL), driver->window, panel_proc, (LPARAM)driver);
+    return ASE_OK;
+}
+
+DEFINE_THISCALL_WRAPPER(asio_future, 12)
+static LONG __thiscall asio_future(struct asio_driver *driver, LONG selector, void *opt)
+{
+    TRACE("%#x, %p\n", (int)selector, opt);
+
+    switch (selector)
+    {
+    case kAsioCanTimeInfo:
+    case kAsioCanReportOverload:
+        return ASE_SUCCESS;
+    case kAsioEnableTimeCodeRead:
+    case kAsioDisableTimeCodeRead:
+        return ASE_SUCCESS;
+    default:
+        return ASE_InvalidParameter;
+    }
+}
+
+DEFINE_THISCALL_WRAPPER(asio_output_ready, 4)
+static LONG __thiscall asio_output_ready(struct asio_driver *driver)
+{
+    /* outputs are taken when the buffer switch returns */
+    return ASE_NotPresent;
+}
+
+static const void * const driver_vtbl[] =
+{
+    driver_QueryInterface,
+    driver_AddRef,
+    driver_Release,
+    THISCALL(asio_init),
+    THISCALL(asio_get_driver_name),
+    THISCALL(asio_get_driver_version),
+    THISCALL(asio_get_error_message),
+    THISCALL(asio_start),
+    THISCALL(asio_stop),
+    THISCALL(asio_get_channels),
+    THISCALL(asio_get_latencies),
+    THISCALL(asio_get_buffer_size),
+    THISCALL(asio_can_sample_rate),
+    THISCALL(asio_get_sample_rate),
+    THISCALL(asio_set_sample_rate),
+    THISCALL(asio_get_clock_sources),
+    THISCALL(asio_set_clock_source),
+    THISCALL(asio_get_sample_position),
+    THISCALL(asio_get_channel_info),
+    THISCALL(asio_create_buffers),
+    THISCALL(asio_dispose_buffers),
+    THISCALL(asio_control_panel),
+    THISCALL(asio_future),
+    THISCALL(asio_output_ready),
+};
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IClassFactory))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **obj)
+{
+    struct asio_driver *driver;
+
+    TRACE("%p, %s, %p\n", outer, debugstr_guid(riid), obj);
+
+    *obj = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    /* hosts ask for the driver's class id as the interface */
+    if (!IsEqualIID(riid, &IID_IUnknown) && !IsEqualIID(riid, &CLSID_RayeASIO)) return E_NOINTERFACE;
+    if (!(driver = calloc(1, sizeof(*driver)))) return E_OUTOFMEMORY;
+    driver->vtbl = driver_vtbl;
+    driver->ref = 1;
+    *obj = driver;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateInstance,
+    factory_LockServer,
+};
+
+static IClassFactory factory = { &factory_vtbl };
+
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **obj)
+{
+    TRACE("%s, %s, %p\n", debugstr_guid(clsid), debugstr_guid(riid), obj);
+
+    if (!IsEqualGUID(clsid, &CLSID_RayeASIO)) return CLASS_E_CLASSNOTAVAILABLE;
+    return IClassFactory_QueryInterface(&factory, riid, obj);
+}
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_FALSE;
+}
+
+static LSTATUS set_string(HKEY root, const WCHAR *key, const WCHAR *name, const WCHAR *value)
+{
+    return RegSetKeyValueW(root, key, name, REG_SZ, value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+}
+
+HRESULT WINAPI DllRegisterServer(void)
+{
+    WCHAR key[80], path[MAX_PATH];
+
+    GetModuleFileNameW(instance, path, ARRAY_SIZE(path));
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s", clsid_string);
+    if (set_string(HKEY_CLASSES_ROOT, key, NULL, driver_name)) return SELFREG_E_CLASS;
+    lstrcatW(key, L"\\InprocServer32");
+    if (set_string(HKEY_CLASSES_ROOT, key, NULL, path) ||
+        set_string(HKEY_CLASSES_ROOT, key, L"ThreadingModel", L"Both"))
+        return SELFREG_E_CLASS;
+
+    swprintf(key, ARRAY_SIZE(key), L"Software\\ASIO\\%s", driver_name);
+    if (set_string(HKEY_LOCAL_MACHINE, key, L"CLSID", clsid_string) ||
+        set_string(HKEY_LOCAL_MACHINE, key, L"Description", driver_name))
+        return SELFREG_E_CLASS;
+    return S_OK;
+}
+
+HRESULT WINAPI DllUnregisterServer(void)
+{
+    WCHAR key[80];
+
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s", clsid_string);
+    RegDeleteTreeW(HKEY_CLASSES_ROOT, key);
+    swprintf(key, ARRAY_SIZE(key), L"Software\\ASIO\\%s", driver_name);
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, key);
+    return S_OK;
+}
+
+BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        instance = inst;
+        DisableThreadLibraryCalls(inst);
+        return !__wine_init_unix_call();
+    }
+    return TRUE;
+}
