diff --git a/dlls/rayeasio/unixlib.h b/dlls/rayeasio/unixlib.h
new file mode 100644
index 0000000..1a8f2cf
--- /dev/null
+++ b/dlls/rayeasio/unixlib.h
@@ -0,0 +1,102 @@
+/*
+ * Raye ASIO driver, interface between the PE and unix sides
+ *
+ * Copyright 2026 Raye Linux
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "wine/unixlib.h"
+
+/* Every field has the same size in 32-bit and 64-bit code, so the WoW64
+ * side uses the same entry points. Pointers travel as UINT64. */
+
+#define ASIO_MAX_CHANNELS 32
+
+struct asio_open_params
+{
+    char client_name[64];
+    UINT32 inputs;          /* 0: as many as the default input has, at least 2 */
+    UINT32 outputs;
+    UINT64 handle;          /* out */
+    UINT32 sample_rate;     /* out */
+    UINT32 current_size;    /* out */
+    NTSTATUS result;        /* out */
+};
+
+struct asio_handle_params
+{
+    UINT64 handle;
+};
+
+struct asio_info_params
+{
+    UINT64 handle;
+    UINT32 sample_rate;
+    UINT32 buffer_size;
+    UINT32 inputs;
+    UINT32 outputs;
+    UINT32 input_latency;
+    UINT32 output_latency;
+};
+
+struct asio_prepare_params
+{
+    UINT64 handle;
+    UINT32 frames;
+    UINT32 input_mask;      /* channels the host created buffers for */
+    UINT32 output_mask;
+    UINT64 inputs[ASIO_MAX_CHANNELS][2];   /* float buffers, double buffered */
+    UINT64 outputs[ASIO_MAX_CHANNELS][2];
+    NTSTATUS result;
+};
+
+struct asio_run_params
+{
+    UINT64 handle;
+    UINT32 running;
+};
+
+/* asio_cycle flags */
+#define ASIO_CYCLE_STOP          0x01
+#define ASIO_CYCLE_RESET         0x02  /* buffer size changed */
+#define ASIO_CYCLE_LATENCY       0x04
+#define ASIO_CYCLE_RATE          0x08
+#define ASIO_CYCLE_XRUN          0x10
+#define ASIO_CYCLE_READY         0x20  /* index and position are valid */
+
+struct asio_cycle_params
+{
+    UINT64 handle;
+    UINT32 done;            /* in: the host has filled the outputs of the last cycle */
+    UINT32 index;           /* out: buffer half to process */
+    UINT64 position;        /* out: sample position at the start of the cycle */
+    UINT32 sample_rate;     /* out */
+    UINT32 flags;           /* out */
+    UINT32 xruns;           /* out: cycles missed since start */
+};
+
+enum asio_funcs
+{
+    unix_asio_open,
+    unix_asio_close,
+    unix_asio_get_info,
+    unix_asio_prepare,
+    unix_asio_release,
+    unix_asio_run,
+    unix_asio_realtime,
+    unix_asio_cycle,
+    unix_asio_funcs_count,
+};
