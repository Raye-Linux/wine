+HKCU,Software\Wine\Fonts\Replacements,"Gulim",0x10002,"Noto Sans CJK KR"
+HKCU,Software\Wine\Fonts\Replacements,"Dotum",0x10002,"Noto Sans CJK KR"
+
 [MCI]
 HKLM,%Mci32Str%,"AVIVideo",,"mciavi32.dll"
 HKLM,%Mci32Str%,"CDAudio",,"mcicda.dll"
