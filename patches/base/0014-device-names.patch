Subject: Device and codec names without the project name

DirectInput named the system mouse and keyboard "Wine Mouse" and "Wine
Keyboard", which games show in their control settings, and the PCM
codec in the ACM list was the "Wine PCM converter".
---
diff --git a/dlls/dinput/keyboard.c b/dlls/dinput/keyboard.c
index 5f3710e..3afec02 100644
--- a/dlls/dinput/keyboard.c
+++ b/dlls/dinput/keyboard.c
@@ -180,7 +180,7 @@ HRESULT keyboard_enum_device( DWORD type, DWORD flags, DIDEVICEINSTANCEW *instan
     if (version >= 0x0800) instance->dwDevType = DI8DEVTYPE_KEYBOARD | (subtype << 8);
     else instance->dwDevType = DIDEVTYPE_KEYBOARD | (subtype << 8);
     MultiByteToWideChar( CP_ACP, 0, "Keyboard", -1, instance->tszInstanceName, MAX_PATH );
-    MultiByteToWideChar( CP_ACP, 0, "Wine Keyboard", -1, instance->tszProductName, MAX_PATH );
+    MultiByteToWideChar( CP_ACP, 0, "Keyboard", -1, instance->tszProductName, MAX_PATH );
 
     return DI_OK;
 }
diff --git a/dlls/dinput/mouse.c b/dlls/dinput/mouse.c
index 5c0bdbc..7f149c9 100644
--- a/dlls/dinput/mouse.c
+++ b/dlls/dinput/mouse.c
@@ -80,7 +80,7 @@ HRESULT mouse_enum_device( DWORD type, DWORD flags, DIDEVICEINSTANCEW *instance,
     if (version >= 0x0800) instance->dwDevType = DI8DEVTYPE_MOUSE | (DI8DEVTYPEMOUSE_TRADITIONAL << 8);
     else instance->dwDevType = DIDEVTYPE_MOUSE | (DIDEVTYPEMOUSE_TRADITIONAL << 8);
     MultiByteToWideChar( CP_ACP, 0, "Mouse", -1, instance->tszInstanceName, MAX_PATH );
-    MultiByteToWideChar( CP_ACP, 0, "Wine Mouse", -1, instance->tszProductName, MAX_PATH );
+    MultiByteToWideChar( CP_ACP, 0, "Mouse", -1, instance->tszProductName, MAX_PATH );
 
     return DI_OK;
 }
diff --git a/dlls/msacm32/pcmconverter.c b/dlls/msacm32/pcmconverter.c
index 0b9724b..558edb3 100644
--- a/dlls/msacm32/pcmconverter.c
+++ b/dlls/msacm32/pcmconverter.c
@@ -984,9 +984,9 @@ static	LRESULT PCM_DriverDetails(PACMDRIVERDETAILSW add)
     add->cFilterTags = 0;
     add->hicon = NULL;
     MultiByteToWideChar(CP_ACP, 0, "MS-PCM", -1, add->szShortName, ARRAY_SIZE(add->szShortName));
-    MultiByteToWideChar(CP_ACP, 0, "Wine PCM converter", -1,
+    MultiByteToWideChar(CP_ACP, 0, "PCM Converter", -1,
                         add->szLongName, ARRAY_SIZE(add->szLongName));
-    MultiByteToWideChar(CP_ACP, 0, "Brought to you by the Wine team...", -1,
+    MultiByteToWideChar(CP_ACP, 0, "", -1,
                         add->szCopyright, ARRAY_SIZE(add->szCopyright));
     MultiByteToWideChar(CP_ACP, 0, "Refer to LICENSE file", -1,
                         add->szLicensing, ARRAY_SIZE(add->szLicensing) );
@@ -1336,7 +1336,7 @@ LRESULT CALLBACK PCM_DriverProc(DWORD_PTR dwDevID, HDRVR hDriv, UINT wMsg,
     case DRV_ENABLE:		return 1;
     case DRV_DISABLE:		return 1;
     case DRV_QUERYCONFIGURE:	return 1;
-    case DRV_CONFIGURE:		MessageBoxA(0, "MSACM PCM filter !", "Wine Driver", MB_OK); return 1;
+    case DRV_CONFIGURE:		MessageBoxA(0, "PCM converter", "PCM Converter", MB_OK); return 1;
     case DRV_INSTALL:		return DRVCNF_RESTART;
     case DRV_REMOVE:		return DRVCNF_RESTART;
 
