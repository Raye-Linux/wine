Subject: ntdll: let WINE_LARGE_ADDRESS_AWARE give 32-bit programs 4 GB

A 32-bit program without the large-address flag in its header only gets
2 GB, and many older games run out of memory there with today's
textures. WINE_LARGE_ADDRESS_AWARE=1 treats the program as if the flag
were set, the way the layer Steam uses does for every game. Unset, or
anything other than 1, changes nothing.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index b61da59..d78372a 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3631,6 +3631,17 @@ static struct thread_data *init_thread_data( void *ptr )
     return data;
 }
 
+/* WINE_LARGE_ADDRESS_AWARE=1 gives a 32-bit program the 4 GB it would
+ * get with the flag in its header; many older games run out of memory
+ * at 2 GB with modern textures */
+static BOOL large_address_aware(void)
+{
+    const char *env = getenv( "WINE_LARGE_ADDRESS_AWARE" );
+
+    if (main_image_info.ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE) return TRUE;
+    return env && env[0] == '1' && !env[1];
+}
+
 /* enable use of a large address space when allowed by the application */
 static void set_large_address_space(void)
 {
@@ -3660,7 +3671,7 @@ static void set_large_address_space(void)
 
     if (is_win64)
     {
-        if (main_image_info.ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE)
+        if (large_address_aware())
         {
             user_space_wow_limit = limit_4g - 1;
             /* block a bit of top memory: some apps break if the entire high 2G is available */
@@ -3672,7 +3683,7 @@ static void set_large_address_space(void)
             set_mem_area_state( (void *)0x7fff0000, 0x10000, AREA_BLOCKED );
         }
     }
-    else if (!(main_image_info.ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE))
+    else if (!large_address_aware())
     {
         reserve_area( (void *)limit_2g, host_addr_space_limit );
         return;
