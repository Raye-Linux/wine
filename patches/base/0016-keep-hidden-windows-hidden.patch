Subject: winex11: keep a window hidden when the WM answers late

A late WM_STATE reply to an earlier map request could arrive after the
window had been hidden again, and the window stayed on screen. Roblox
Studio hides six small helper windows at start; under Xwayland they
were left as black squares over its sign-in page. From kombucha.
---
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 7f6bf0ffd1f..21c2b042bf6 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1875,6 +1875,7 @@ void window_wm_state_notify( struct x11drv_win_data *data, unsigned long serial,
     UINT *desired = &data->desired_state.wm_state, *pending = &data->pending_state.wm_state, *current = &data->current_state.wm_state;
     unsigned long *expect_serial = &data->wm_state_serial;
     const char *reason = NULL, *expected, *received, *prefix;
+    UINT preserved = WithdrawnState;
 
     prefix = wine_dbg_sprintf( "window %p/%lx ", data->hwnd, data->whole_window );
     received = wine_dbg_sprintf( "WM_STATE %#x/%lu", value, serial );
@@ -1882,6 +1883,9 @@ void window_wm_state_notify( struct x11drv_win_data *data, unsigned long serial,
     /* ignore Metacity/Mutter transient NormalState during WithdrawnState <-> IconicState transitions */
     if (value == NormalState && *current + *pending == IconicState) reason = "transient ";
 
+    /* the WM never maps a window on its own, don't let late replies to a map request overwrite a hide request */
+    if (data->managed && !data->embedded && *desired == WithdrawnState && value != WithdrawnState) desired = &preserved;
+
     if (!handle_state_change( serial, expect_serial, sizeof(value), &value, desired, pending,
                               current, expected, prefix, received, reason ))
         return;
