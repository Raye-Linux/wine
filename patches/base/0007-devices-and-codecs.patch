Subject: winmm, codecs, internet settings: device names programs list

Names programs show in their device and codec lists: Sound Mapper,
Game controller, the AVI handler and the two video codecs, plus the
internet settings and certificate import texts.
---
diff --git a/dlls/avifil32/avifil32.rc b/dlls/avifil32/avifil32.rc
index dd18450..31a25c9 100644
--- a/dlls/avifil32/avifil32.rc
+++ b/dlls/avifil32/avifil32.rc
@@ -32,7 +32,7 @@ STRINGTABLE
   IDS_ALLFILES		"All files (*.*)"
   IDS_VIDEO		"video"
   IDS_AUDIO		"audio"
-  IDS_AVIFILETYPE	"Wine AVI-default-filehandler"
+  IDS_AVIFILETYPE	"AVI default file handler"
   IDS_UNCOMPRESSED      "uncompressed"
 }
 
