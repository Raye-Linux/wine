Subject: wbemprox, hid and bus drivers: Windows names for devices and makers

Programs that list hardware (system information tools, crash reporters,
launchers) read the names of devices and their makers from WMI and from
the device installation files. They said "Wine" and "The Wine Project".
Give them the names Windows uses for the same kind of device.
---
diff --git a/dlls/hidclass.sys/input.inf b/dlls/hidclass.sys/input.inf
--- a/dlls/hidclass.sys/input.inf
+++ b/dlls/hidclass.sys/input.inf
@@ -4,10 +4,10 @@
 Class=HIDClass
 
 [Manufacturer]
-Wine=mfg_section
+(Standard system devices)=mfg_section
 
 [mfg_section]
-Wine HID device=device_section,HID_DEVICE
+HID-compliant device=device_section,HID_DEVICE
 
 [device_section.Services]
 AddService = ,0x2
diff --git a/dlls/mouhid.sys/mouhid.inf b/dlls/mouhid.sys/mouhid.inf
--- a/dlls/mouhid.sys/mouhid.inf
+++ b/dlls/mouhid.sys/mouhid.inf
@@ -4,7 +4,7 @@
 Class=System
 
 [Manufacturer]
-Wine=mfg_section
+(Standard system devices)=mfg_section
 
 [mfg_section]
 HID touch screen device=device_section,HID_DEVICE_UP:000D_U:0004
@@ -13,8 +13,8 @@
 AddService = mouhid,0x2,svc_section
 
 [svc_section]
-Description="Wine HID mouse device driver"
-DisplayName="Wine HID mouse"
+Description="HID mouse driver"
+DisplayName="HID mouse"
 ServiceBinary="%12%\mouhid.sys"
 LoadOrderGroup="WinePlugPlay"
 ServiceType=1
diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -1663,7 +1663,7 @@
 static WCHAR *get_bios_manufacturer( const char *buf, UINT len )
 {
     WCHAR *ret = get_smbios_string( SMBIOS_TYPE_BIOS, 0, offsetof(struct smbios_bios, vendor), buf, len );
-    if (!ret) return wcsdup( L"The Wine Project" );
+    if (!ret) return wcsdup( L"System manufacturer" );
     return ret;
 }
 
@@ -1709,7 +1709,7 @@
 static WCHAR *get_bios_smbiosbiosversion( const char *buf, UINT len )
 {
     WCHAR *ret = get_smbios_string( SMBIOS_TYPE_BIOS, 0, offsetof(struct smbios_bios, version), buf, len );
-    if (!ret) return wcsdup( L"Wine" );
+    if (!ret) return wcsdup( L"1.0" );
     return ret;
 }
 
@@ -1998,14 +1998,14 @@
 static WCHAR *get_compsysproduct_name( const char *buf, UINT len )
 {
     WCHAR *ret = get_smbios_string( SMBIOS_TYPE_SYSTEM, 0, offsetof(struct smbios_system, product), buf, len );
-    if (!ret) return wcsdup( L"Wine" );
+    if (!ret) return wcsdup( L"System Product Name" );
     return ret;
 }
 
 static WCHAR *get_compsysproduct_vendor( const char *buf, UINT len )
 {
     WCHAR *ret = get_smbios_string( SMBIOS_TYPE_SYSTEM, 0, offsetof(struct smbios_system, vendor), buf, len );
-    if (!ret) return wcsdup( L"The Wine Project" );
+    if (!ret) return wcsdup( L"System manufacturer" );
     return ret;
 }
 
@@ -3262,7 +3262,7 @@
         rec->index                = aa->IfIndex;
         rec->interface_index      = aa->IfIndex;
         rec->mac_address          = get_mac_address( aa->PhysicalAddress, aa->PhysicalAddressLength );
-        rec->manufacturer         = L"The Wine Project";
+        rec->manufacturer         = L"(Standard network adapters)";
         rec->name                 = wcsdup( aa->FriendlyName );
         rec->netenabled           = connection_status ? -1 : 0;
         rec->netconnection_status = connection_status;
@@ -3535,7 +3535,7 @@
     rec->devicelocator        = L"DIMM 0";
     rec->formfactor           = 8; /* DIMM */
     rec->memorytype           = 9; /* RAM */
-    rec->manufacturer         = L"Wine";
+    rec->manufacturer         = L"";
     rec->partnumber           = L"";
     rec->serial               = L"";
     rec->speed                = 3200;
@@ -3629,7 +3629,7 @@
                             ret[i].caption = get_reg_value( key_instance, L"DeviceDesc" );
                             ret[i].class_guid = wcslwr( get_reg_value( key_instance, L"ClassGUID" ) );
                             ret[i].device_id = wcsupr( build_pnp_device_id( class, product, instance ) );
-                            ret[i].manufacturer = L"The Wine Project";
+                            ret[i].manufacturer = L"(Standard system devices)";
                             ret[i].name = get_reg_value( key_instance, L"DeviceDesc" );
                             ret[i].service = get_reg_value( key_instance, L"Service" );
                             RegCloseKey( key_instance );
@@ -4291,7 +4291,7 @@
     rec->lastbootuptime         = get_lastbootuptime();
     rec->localdatetime          = get_localdatetime();
     rec->locale                 = get_locale();
-    rec->manufacturer           = L"The Wine Project";
+    rec->manufacturer           = L"Microsoft Corporation";
     rec->name                   = get_osname( rec->caption );
     rec->operatingsystemsku     = get_operatingsystemsku();
     rec->organization           = get_organization();
@@ -4575,7 +4575,7 @@
 static WCHAR *get_systemenclosure_manufacturer( const char *buf, UINT len )
 {
     WCHAR *ret = get_smbios_string( SMBIOS_TYPE_CHASSIS, 0, offsetof(struct smbios_chassis, vendor), buf, len );
-    if (!ret) return wcsdup( L"Wine" );
+    if (!ret) return wcsdup( L"System manufacturer" );
     return ret;
 }
 
@@ -4957,7 +4957,7 @@
     rec = (struct record_sounddevice *)table->data;
     rec->caption = L"High Definition Audio Device";
     rec->deviceid = L"HDAUDIO\\FUNC_01&VEN_0000&DEV_0000&SUBSYS_00000000&REV_0000\\0&DEADBEEF&0&DEAD";
-    rec->manufacturer = L"The Wine Project";
+    rec->manufacturer = L"(Standard system devices)";
     rec->name = L"High Definition Audio Device";
     rec->pnpdeviceid = rec->deviceid;
     rec->productname = L"High Definition Audio Device";
