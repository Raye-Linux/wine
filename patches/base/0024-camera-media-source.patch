+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "gst_private.h"
+
+#include "mfapi.h"
+#include "mferror.h"
+
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+enum capture_state
+{
+    CAPTURE_STOPPED,
+    CAPTURE_PAUSED,
+    CAPTURE_RUNNING,
+    CAPTURE_SHUTDOWN,
+};
+
+struct sample_token
+{
+    struct list entry;
+    IUnknown *token;
+};
+
+struct video_capture
+{
+    IMFMediaSource IMFMediaSource_iface;
+    IMFMediaStream IMFMediaStream_iface;
+    LONG refcount;
+
+    IMFMediaEventQueue *event_queue;
+    IMFMediaEventQueue *stream_queue;
+    IMFPresentationDescriptor *descriptor;
+    IMFStreamDescriptor *stream_descriptor;
+
+    wg_camera_t camera;
+    struct wg_camera_mode *modes;
+    UINT32 mode_count;
+    UINT32 mode;            /* the one running, or ~0u */
+    UINT64 rate;            /* the rate asked for, 0 for the highest */
+    UINT32 fps_n, fps_d;    /* the rate the camera runs at */
+
+    CRITICAL_SECTION cs;
+    enum capture_state state;
+    BOOL stream_active;
+    struct list tokens;
+    LONGLONG start_position, first_pts, next_time;
+    BOOL have_first_pts;
+    UINT32 generation;      /* bumped when the camera restarts, stale frames are dropped */
+
+    HANDLE thread, wake;
+    BOOL exit_thread;
+};
+
+static struct video_capture *impl_from_IMFMediaSource(IMFMediaSource *iface)
+{
+    return CONTAINING_RECORD(iface, struct video_capture, IMFMediaSource_iface);
+}
+
+static struct video_capture *impl_from_IMFMediaStream(IMFMediaStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct video_capture, IMFMediaStream_iface);
+}
+
+static HRESULT status_to_hresult(NTSTATUS status)
+{
+    switch (status)
+    {
+    case STATUS_SUCCESS: return S_OK;
+    case STATUS_DEVICE_BUSY: return MF_E_HW_MFT_FAILED_START_STREAMING;
+    case STATUS_DEVICE_NOT_CONNECTED: return MF_E_VIDEO_RECORDING_DEVICE_INVALIDATED;
+    case STATUS_NOT_FOUND: return MF_E_NOT_FOUND;
+    default: return HRESULT_FROM_NT(status);
+    }
+}
+
+static HRESULT create_media_type(const struct wg_camera_mode *mode, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &mode->subtype);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_SIZE, (UINT64)mode->width << 32 | mode->height);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_RATE, (UINT64)mode->fps_n << 32 | mode->fps_d);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_RATE_RANGE_MAX, (UINT64)mode->fps_n << 32 | mode->fps_d);
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_RATE_RANGE_MIN, (UINT64)mode->fps_min_n << 32 | mode->fps_min_d);
+    IMFMediaType_SetUINT64(type, &MF_MT_PIXEL_ASPECT_RATIO, (UINT64)1 << 32 | 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, TRUE);
+    if (IsEqualGUID(&mode->subtype, &MFVideoFormat_MJPG))
+    {
+        IMFMediaType_SetUINT32(type, &MF_MT_COMPRESSED, TRUE);
+        IMFMediaType_SetUINT32(type, &MF_MT_FIXED_SIZE_SAMPLES, FALSE);
+    }
+    else
+    {
+        IMFMediaType_SetUINT32(type, &MF_MT_FIXED_SIZE_SAMPLES, TRUE);
+        IMFMediaType_SetUINT32(type, &MF_MT_SAMPLE_SIZE, mode->sample_size);
+        IMFMediaType_SetUINT32(type, &MF_MT_DEFAULT_STRIDE, mode->stride);
+        IMFMediaType_SetUINT32(type, &MF_MT_AVG_BITRATE,
+                (UINT32)min((UINT64)mode->sample_size * 8 * mode->fps_n / max(mode->fps_d, 1), UINT_MAX));
+    }
+    *out = type;
+    return S_OK;
+}
+
+/* The mode a media type asks for: same format and size, and the closest
+ * rate. Programs often build their own type instead of taking one of ours. */
+static HRESULT find_mode(struct video_capture *capture, IMFMediaType *type, UINT32 *index, UINT64 *ret_rate)
+{
+    UINT64 size, rate = 0;
+    UINT32 i, best = ~0u;
+    double want, diff, best_diff = 0;
+    GUID subtype;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype))
+            || FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)))
+        return MF_E_INVALIDMEDIATYPE;
+    IMFMediaType_GetUINT64(type, &MF_MT_FRAME_RATE, &rate);
+    want = (UINT32)rate ? (double)(rate >> 32) / (UINT32)rate : 0;
+
+    for (i = 0; i < capture->mode_count; ++i)
+    {
+        const struct wg_camera_mode *mode = &capture->modes[i];
+
+        if (!IsEqualGUID(&mode->subtype, &subtype) || mode->width != (UINT32)(size >> 32)
+                || mode->height != (UINT32)size)
+            continue;
+        diff = fabs((double)mode->fps_n / mode->fps_d - want);
+        if (best == ~0u || diff < best_diff)
+        {
+            best = i;
+            best_diff = diff;
+        }
+    }
+    if (best == ~0u)
+        return MF_E_INVALIDMEDIATYPE;
+    *index = best;
+    *ret_rate = rate;
+    return S_OK;
+}
+
+static void flush_tokens(struct video_capture *capture)
+{
+    struct sample_token *token, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(token, next, &capture->tokens, struct sample_token, entry)
+    {
+        list_remove(&token->entry);
+        if (token->token)
+            IUnknown_Release(token->token);
+        free(token);
+    }
+}
+
+static void stop_camera(struct video_capture *capture)
+{
+    if (capture->mode != ~0u)
+    {
+        WINE_UNIX_CALL(unix_wg_camera_stop, &capture->camera);
+        capture->mode = ~0u;
+        capture->generation++;
+    }
+}
+
+static void deliver_frame(struct video_capture *capture, IMFMediaBuffer *buffer, LONGLONG pts, UINT32 generation)
+{
+    struct sample_token *token;
+    LONGLONG time, duration;
+    IMFSample *sample;
+
+    if (capture->state != CAPTURE_RUNNING || list_empty(&capture->tokens) || capture->mode == ~0u
+            || generation != capture->generation)
+        return;
+    if (FAILED(MFCreateSample(&sample)))
+        return;
+
+    if (!capture->have_first_pts)
+    {
+        capture->first_pts = pts;
+        capture->have_first_pts = TRUE;
+        IMFSample_SetUINT32(sample, &MFSampleExtension_Discontinuity, TRUE);
+    }
+    time = capture->start_position + max(pts - capture->first_pts, 0);
+    duration = (LONGLONG)10000000 * capture->fps_d / max(capture->fps_n, 1);
+    capture->next_time = time + duration;
+    IMFSample_AddBuffer(sample, buffer);
+    IMFSample_SetSampleTime(sample, time);
+    IMFSample_SetSampleDuration(sample, duration);
+    IMFSample_SetUINT32(sample, &MFSampleExtension_CleanPoint, TRUE);
+
+    token = LIST_ENTRY(list_head(&capture->tokens), struct sample_token, entry);
+    list_remove(&token->entry);
+    if (token->token)
+        IMFSample_SetUnknown(sample, &MFSampleExtension_Token, token->token);
+    IMFMediaEventQueue_QueueEventParamUnk(capture->stream_queue, MEMediaSample, &GUID_NULL, S_OK,
+            (IUnknown *)sample);
+    IMFSample_Release(sample);
+    if (token->token)
+        IUnknown_Release(token->token);
+    free(token);
+}
+
+static DWORD CALLBACK capture_thread(void *arg)
+{
+    struct video_capture *capture = arg;
+    struct wg_camera_read_params params = {.camera = capture->camera, .timeout_ms = 200};
+    UINT32 capacity = 0, generation;
+
+    SetThreadDescription(GetCurrentThread(), L"camera_capture");
+
+    for (;;)
+    {
+        IMFMediaBuffer *buffer = NULL;
+        NTSTATUS status;
+        DWORD length;
+        BYTE *data;
+
+        EnterCriticalSection(&capture->cs);
+        if (capture->exit_thread)
+        {
+            LeaveCriticalSection(&capture->cs);
+            break;
+        }
+        if (capture->state != CAPTURE_RUNNING || list_empty(&capture->tokens) || capture->mode == ~0u)
+        {
+            LeaveCriticalSection(&capture->cs);
+            WaitForSingleObject(capture->wake, INFINITE);
+            continue;
+        }
+        if (!capacity || capacity < capture->modes[capture->mode].sample_size)
+        {
+            const struct wg_camera_mode *mode = &capture->modes[capture->mode];
+            capacity = mode->sample_size ? mode->sample_size : mode->width * mode->height * 2;
+        }
+        generation = capture->generation;
+        LeaveCriticalSection(&capture->cs);
+
+        if (FAILED(MFCreateMemoryBuffer(capacity, &buffer)))
+        {
+            Sleep(10);
+            continue;
+        }
+        IMFMediaBuffer_Lock(buffer, &data, &length, NULL);
+        params.data = (UINT_PTR)data;
+        params.capacity = length;
+        status = WINE_UNIX_CALL(unix_wg_camera_read, &params);
+        IMFMediaBuffer_Unlock(buffer);
+
+        if (status == STATUS_BUFFER_TOO_SMALL)
+            capacity = params.size;
+        else if (status == STATUS_DEVICE_NOT_CONNECTED)
+        {
+            EnterCriticalSection(&capture->cs);
+            if (capture->state == CAPTURE_RUNNING && generation == capture->generation)
+            {
+                WARN("Lost the camera.\n");
+                capture->state = CAPTURE_STOPPED;
+                flush_tokens(capture);
+                stop_camera(capture);
+                IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, MEVideoCaptureDeviceRemoved,
+                        &GUID_NULL, S_OK, NULL);
+                IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, MEError, &GUID_NULL,
+                        MF_E_VIDEO_RECORDING_DEVICE_INVALIDATED, NULL);
+            }
+            LeaveCriticalSection(&capture->cs);
+        }
+        else if (!status)
+        {
+            IMFMediaBuffer_SetCurrentLength(buffer, params.size);
+            EnterCriticalSection(&capture->cs);
+            deliver_frame(capture, buffer, params.pts, generation);
+            LeaveCriticalSection(&capture->cs);
+        }
+        IMFMediaBuffer_Release(buffer);
+    }
+
+    return 0;
+}
+
+static HRESULT WINAPI stream_QueryInterface(IMFMediaStream *iface, REFIID riid, void **out)
+{
+    struct video_capture *capture = impl_from_IMFMediaStream(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFMediaStream) || IsEqualIID(riid, &IID_IMFMediaEventGenerator)
+            || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = &capture->IMFMediaStream_iface;
+        IMFMediaStream_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI stream_AddRef(IMFMediaStream *iface)
