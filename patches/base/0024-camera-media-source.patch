+static HRESULT WINAPI source_GetEvent(IMFMediaSource *iface, DWORD flags, IMFMediaEvent **event)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    return IMFMediaEventQueue_GetEvent(capture->event_queue, flags, event);
+}
+
+static HRESULT WINAPI source_BeginGetEvent(IMFMediaSource *iface, IMFAsyncCallback *callback, IUnknown *state)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    return IMFMediaEventQueue_BeginGetEvent(capture->event_queue, callback, state);
+}
+
+static HRESULT WINAPI source_EndGetEvent(IMFMediaSource *iface, IMFAsyncResult *result, IMFMediaEvent **event)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    return IMFMediaEventQueue_EndGetEvent(capture->event_queue, result, event);
+}
+
+static HRESULT WINAPI source_QueueEvent(IMFMediaSource *iface, MediaEventType event_type, REFGUID ext_type,
+        HRESULT hr, const PROPVARIANT *value)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    return IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, event_type, ext_type, hr, value);
+}
+
+static HRESULT WINAPI source_GetCharacteristics(IMFMediaSource *iface, DWORD *characteristics)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, characteristics);
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+        *characteristics = MFMEDIASOURCE_IS_LIVE;
+    LeaveCriticalSection(&capture->cs);
+    return hr;
+}
+
+static HRESULT WINAPI source_CreatePresentationDescriptor(IMFMediaSource *iface,
+        IMFPresentationDescriptor **descriptor)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, descriptor);
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+        hr = IMFPresentationDescriptor_Clone(capture->descriptor, descriptor);
+    LeaveCriticalSection(&capture->cs);
+    return hr;
+}
+
+static HRESULT start_stream(struct video_capture *capture, IMFPresentationDescriptor *descriptor)
+{
+    struct wg_camera_start_params params = {.camera = capture->camera};
+    IMFStreamDescriptor *stream_descriptor;
+    IMFMediaTypeHandler *handler;
+    IMFMediaType *type = NULL;
+    BOOL selected = FALSE;
+    NTSTATUS status;
+    UINT64 rate = 0;
+    UINT32 mode;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(descriptor, 0, &selected,
+            &stream_descriptor)))
+        return hr;
+    if (selected && SUCCEEDED(hr = IMFStreamDescriptor_GetMediaTypeHandler(stream_descriptor, &handler)))
+    {
+        hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, &type);
+        IMFMediaTypeHandler_Release(handler);
+    }
+    IMFStreamDescriptor_Release(stream_descriptor);
+
+    if (!selected)
+    {
+        stop_camera(capture);
+        capture->stream_active = FALSE;
+        return S_OK;
+    }
+    if (FAILED(hr))
+        return hr;
+    hr = find_mode(capture, type, &mode, &rate);
+    IMFMediaType_Release(type);
+    if (FAILED(hr))
+        return hr;
+
+    if (mode != capture->mode || rate != capture->rate)
+    {
+        stop_camera(capture);
+        params.mode = mode;
+        params.fps_n = rate >> 32;
+        params.fps_d = (UINT32)rate;
+        TRACE("Starting mode %u, %ux%u %s.\n", mode, capture->modes[mode].width, capture->modes[mode].height,
+                debugstr_guid(&capture->modes[mode].subtype));
+        if ((status = WINE_UNIX_CALL(unix_wg_camera_start, &params)))
+        {
+            WARN("Failed to start the camera, status %#lx.\n", status);
+            return status_to_hresult(status);
+        }
+        capture->mode = mode;
+        capture->rate = rate;
+        capture->fps_n = params.fps_n;
+        capture->fps_d = params.fps_d;
+        /* the new pipeline counts from 0 again */
+        capture->have_first_pts = FALSE;
+        capture->start_position = capture->next_time;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI source_Start(IMFMediaSource *iface, IMFPresentationDescriptor *descriptor,
+        const GUID *time_format, const PROPVARIANT *position)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    BOOL was_active;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s, %p.\n", iface, descriptor, debugstr_guid(time_format), position);
+
+    if (!descriptor || !position)
+        return E_INVALIDARG;
+    if (time_format && !IsEqualGUID(time_format, &GUID_NULL))
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (SUCCEEDED(hr = start_stream(capture, descriptor)))
+    {
+        was_active = capture->stream_active && capture->state != CAPTURE_STOPPED;
+        if (capture->state == CAPTURE_STOPPED)
+        {
+            capture->have_first_pts = FALSE;
+            capture->start_position = capture->next_time = position->vt == VT_I8 ? position->hVal.QuadPart : 0;
+        }
+        capture->state = CAPTURE_RUNNING;
+
+        if (capture->mode != ~0u)
+        {
+            IMFMediaEventQueue_QueueEventParamUnk(capture->event_queue, was_active ? MEUpdatedStream : MENewStream,
+                    &GUID_NULL, S_OK, (IUnknown *)&capture->IMFMediaStream_iface);
+            capture->stream_active = TRUE;
+            IMFMediaEventQueue_QueueEventParamVar(capture->stream_queue, MEStreamStarted, &GUID_NULL, S_OK, position);
+        }
+        IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, MESourceStarted, &GUID_NULL, S_OK, position);
+        SetEvent(capture->wake);
+    }
+    LeaveCriticalSection(&capture->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI source_Stop(IMFMediaSource *iface)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        capture->state = CAPTURE_STOPPED;
+        flush_tokens(capture);
+        stop_camera(capture);
+        if (capture->stream_active)
+            IMFMediaEventQueue_QueueEventParamVar(capture->stream_queue, MEStreamStopped, &GUID_NULL, S_OK, NULL);
+        IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, MESourceStopped, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&capture->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI source_Pause(IMFMediaSource *iface)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (capture->state != CAPTURE_RUNNING)
+        hr = MF_E_INVALID_STATE_TRANSITION;
+    else
+    {
+        /* the camera keeps running; Start goes on with the newest frame */
+        capture->state = CAPTURE_PAUSED;
+        if (capture->stream_active)
+            IMFMediaEventQueue_QueueEventParamVar(capture->stream_queue, MEStreamPaused, &GUID_NULL, S_OK, NULL);
+        IMFMediaEventQueue_QueueEventParamVar(capture->event_queue, MESourcePaused, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&capture->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI source_Shutdown(IMFMediaSource *iface)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p.\n", iface);
+
+    capture_shutdown(capture);
+    return S_OK;
+}
+
+static const IMFMediaSourceVtbl source_vtbl =
+{
+    source_QueryInterface,
+    source_AddRef,
+    source_Release,
+    source_GetEvent,
+    source_BeginGetEvent,
+    source_EndGetEvent,
+    source_QueueEvent,
+    source_GetCharacteristics,
+    source_CreatePresentationDescriptor,
+    source_Start,
+    source_Stop,
+    source_Pause,
+    source_Shutdown,
+};
+
+static HRESULT create_descriptors(struct video_capture *capture)
+{
+    IMFMediaTypeHandler *handler;
+    IMFMediaType **types;
+    HRESULT hr = S_OK;
+    UINT32 i, count = 0;
+
+    if (!(types = calloc(capture->mode_count, sizeof(*types))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < capture->mode_count && SUCCEEDED(hr); ++i)
+        if (SUCCEEDED(hr = create_media_type(&capture->modes[i], &types[i])))
+            count++;
+
+    if (SUCCEEDED(hr))
+        hr = MFCreateStreamDescriptor(0, count, types, &capture->stream_descriptor);
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IMFStreamDescriptor_GetMediaTypeHandler(capture->stream_descriptor, &handler)))
+    {
+        hr = IMFMediaTypeHandler_SetCurrentMediaType(handler, types[0]);
+        IMFMediaTypeHandler_Release(handler);
+    }
+    if (SUCCEEDED(hr))
+        hr = MFCreatePresentationDescriptor(1, &capture->stream_descriptor, &capture->descriptor);
+    if (SUCCEEDED(hr))
+        hr = IMFPresentationDescriptor_SelectStream(capture->descriptor, 0);
+
+    for (i = 0; i < count; ++i)
+        IMFMediaType_Release(types[i]);
+    free(types);
+    return hr;
+}
+
+HRESULT WINAPI winegstreamer_enum_video_capture(WCHAR ***ret_names, WCHAR ***ret_links, UINT32 *ret_count)
+{
+    struct wg_camera_enum_params enum_params = {0};
+    struct wg_camera_get_device_params params;
+    WCHAR **names = NULL, **links = NULL;
+    UINT32 i, count = 0;
+
+    TRACE("%p, %p, %p.\n", ret_names, ret_links, ret_count);
+
+    *ret_names = *ret_links = NULL;
+    *ret_count = 0;
+    if (!init_gstreamer())
+        return S_OK;
+    if (WINE_UNIX_CALL(unix_wg_camera_enum, &enum_params) || !enum_params.count)
+        return S_OK;
+
+    names = CoTaskMemAlloc(enum_params.count * sizeof(*names));
+    links = CoTaskMemAlloc(enum_params.count * sizeof(*links));
+    if (!names || !links)
+    {
+        CoTaskMemFree(names);
+        CoTaskMemFree(links);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < enum_params.count; ++i)
+    {
+        params.index = i;
+        if (WINE_UNIX_CALL(unix_wg_camera_get_device, &params))
+            break;
+        names[count] = CoTaskMemAlloc((wcslen(params.name) + 1) * sizeof(WCHAR));
+        links[count] = CoTaskMemAlloc((wcslen(params.link) + 1) * sizeof(WCHAR));
+        if (!names[count] || !links[count])
+        {
+            CoTaskMemFree(names[count]);
+            CoTaskMemFree(links[count]);
+            break;
+        }
+        wcscpy(names[count], params.name);
+        wcscpy(links[count], params.link);
+        TRACE("Camera %s, %u formats, %s.\n", debugstr_w(params.name), params.mode_count, debugstr_w(params.link));
+        count++;
+    }
+
+    *ret_names = names;
+    *ret_links = links;
+    *ret_count = count;
+    return S_OK;
+}
+
+HRESULT WINAPI winegstreamer_create_video_capture_source(const WCHAR *link, IMFMediaSource **out)
+{
+    struct wg_camera_create_params create = {{0}};
+    struct wg_camera_get_mode_params params;
+    struct video_capture *capture;
+    NTSTATUS status;
+    HRESULT hr;
+    UINT32 i;
+
+    TRACE("%s, %p.\n", debugstr_w(link), out);
+
+    *out = NULL;
+    if (!link || wcslen(link) >= ARRAY_SIZE(create.link))
+        return MF_E_NOT_FOUND;
+    if (!init_gstreamer())
+        return E_FAIL;
+
+    wcscpy(create.link, link);
+    if ((status = WINE_UNIX_CALL(unix_wg_camera_create, &create)))
+    {
+        /* opened before any list was asked for: look once more */
+        struct wg_camera_enum_params enum_params;
+        WINE_UNIX_CALL(unix_wg_camera_enum, &enum_params);
+        if ((status = WINE_UNIX_CALL(unix_wg_camera_create, &create)))
+            return status_to_hresult(status);
+    }
+    if (!create.mode_count)
+    {
+        WINE_UNIX_CALL(unix_wg_camera_destroy, &create.camera);
+        return MF_E_NOT_FOUND;
+    }
+
+    if (!(capture = calloc(1, sizeof(*capture))))
+    {
+        WINE_UNIX_CALL(unix_wg_camera_destroy, &create.camera);
+        return E_OUTOFMEMORY;
+    }
+    capture->IMFMediaSource_iface.lpVtbl = &source_vtbl;
+    capture->IMFMediaStream_iface.lpVtbl = &stream_vtbl;
+    capture->refcount = 1;
+    capture->camera = create.camera;
+    capture->mode = ~0u;
+    list_init(&capture->tokens);
+    InitializeCriticalSectionEx(&capture->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    capture->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": video_capture.cs");
+
+    if (!(capture->modes = calloc(create.mode_count, sizeof(*capture->modes))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    params.camera = capture->camera;
+    for (i = 0; i < create.mode_count; ++i)
+    {
+        params.index = i;
+        if (WINE_UNIX_CALL(unix_wg_camera_get_mode, &params))
+            break;
+        capture->modes[capture->mode_count++] = params.mode;
+    }
+
+    if (FAILED(hr = MFCreateEventQueue(&capture->event_queue))
+            || FAILED(hr = MFCreateEventQueue(&capture->stream_queue))
+            || FAILED(hr = create_descriptors(capture)))
+        goto fail;
+    if (!(capture->wake = CreateEventW(NULL, FALSE, FALSE, NULL))
+            || !(capture->thread = CreateThread(NULL, 0, capture_thread, capture, 0, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto fail;
+    }
+
+    TRACE("Created camera source %p with %u formats.\n", capture, capture->mode_count);
+    *out = &capture->IMFMediaSource_iface;
+    return S_OK;
+
+fail:
+    WINE_UNIX_CALL(unix_wg_camera_destroy, &capture->camera);
+    if (capture->wake) CloseHandle(capture->wake);
+    if (capture->descriptor) IMFPresentationDescriptor_Release(capture->descriptor);
+    if (capture->stream_descriptor) IMFStreamDescriptor_Release(capture->stream_descriptor);
+    if (capture->stream_queue) IMFMediaEventQueue_Release(capture->stream_queue);
+    if (capture->event_queue) IMFMediaEventQueue_Release(capture->event_queue);
+    capture->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection(&capture->cs);
+    free(capture->modes);
+    free(capture);
+    return hr;
+}
