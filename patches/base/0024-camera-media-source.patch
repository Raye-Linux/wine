+static ULONG WINAPI source_AddRef(IMFMediaSource *iface)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    ULONG refcount = InterlockedIncrement(&capture->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static void capture_shutdown(struct video_capture *capture)
+{
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+    {
+        LeaveCriticalSection(&capture->cs);
+        return;
+    }
+    capture->state = CAPTURE_SHUTDOWN;
+    capture->exit_thread = TRUE;
+    flush_tokens(capture);
+    SetEvent(capture->wake);
+    LeaveCriticalSection(&capture->cs);
+
+    WaitForSingleObject(capture->thread, INFINITE);
+    CloseHandle(capture->thread);
+    capture->thread = NULL;
+
+    stop_camera(capture);
+    WINE_UNIX_CALL(unix_wg_camera_destroy, &capture->camera);
+    capture->camera = 0;
+
+    IMFMediaEventQueue_Shutdown(capture->event_queue);
+    IMFMediaEventQueue_Shutdown(capture->stream_queue);
+}
+
+static ULONG WINAPI source_Release(IMFMediaSource *iface)
+{
+    struct video_capture *capture = impl_from_IMFMediaSource(iface);
+    ULONG refcount = InterlockedDecrement(&capture->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        capture_shutdown(capture);
+        IMFMediaEventQueue_Release(capture->event_queue);
+        IMFMediaEventQueue_Release(capture->stream_queue);
+        IMFPresentationDescriptor_Release(capture->descriptor);
+        IMFStreamDescriptor_Release(capture->stream_descriptor);
+        CloseHandle(capture->wake);
+        capture->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&capture->cs);
+        free(capture->modes);
+        free(capture);
+    }
+
+    return refcount;
+}
