+static const GUID KSCATEGORY_VIDEO_CAMERA = {0xe5323777, 0xf976, 0x4f5b, {0x9b, 0x55, 0xb9, 0x46, 0x99, 0xc4, 0x6e, 0x44}};
+
+static HRESULT video_capture_create_object(IMFAttributes *attributes, void *user_context, IUnknown **obj)
+{
+    IMFMediaSource *source;
+    WCHAR *link;
+    UINT32 len;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", attributes, user_context, obj);
+
+    if (FAILED(hr = IMFAttributes_GetAllocatedString(attributes,
+            &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK, &link, &len)))
+        return hr;
+    hr = winegstreamer_create_video_capture_source(link, &source);
+    CoTaskMemFree(link);
+    if (SUCCEEDED(hr))
+        *obj = (IUnknown *)source;
+    return hr;
+}
+
+static void video_capture_shutdown_object(void *user_context, IUnknown *obj)
+{
+    IMFMediaSource *source;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(obj, &IID_IMFMediaSource, (void **)&source)))
+    {
+        IMFMediaSource_Shutdown(source);
+        IMFMediaSource_Release(source);
+    }
+}
+
+static void video_capture_free_private(void *user_context)
+{
+}
+
+static const struct activate_funcs video_capture_activate_funcs =
+{
+    video_capture_create_object,
+    video_capture_shutdown_object,
+    video_capture_free_private,
+};
+
+static HRESULT enum_video_capture_sources(IMFAttributes *attributes, IMFActivate ***ret_sources, UINT32 *ret_count)
+{
+    WCHAR **names = NULL, **links = NULL;
+    IMFActivate **sources = NULL;
+    UINT32 i, count = 0, created = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = winegstreamer_enum_video_capture(&names, &links, &count)))
+        return hr;
+
+    if (count && !(sources = CoTaskMemAlloc(count * sizeof(*sources))))
+        hr = E_OUTOFMEMORY;
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+    {
+        if (FAILED(hr = create_activation_object(NULL, &video_capture_activate_funcs, &sources[i])))
+            break;
+        created++;
+        IMFActivate_SetGUID(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID);
+        IMFActivate_SetGUID(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_CATEGORY, &KSCATEGORY_VIDEO_CAMERA);
+        IMFActivate_SetUINT32(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_HW_SOURCE, 1);
+        IMFActivate_SetString(sources[i], &MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME, names[i]);
+        hr = IMFActivate_SetString(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK, links[i]);
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        CoTaskMemFree(names[i]);
+        CoTaskMemFree(links[i]);
+    }
+    CoTaskMemFree(names);
+    CoTaskMemFree(links);
+
+    if (FAILED(hr))
+    {
+        for (i = 0; i < created; ++i)
+            IMFActivate_Release(sources[i]);
+        CoTaskMemFree(sources);
+        return hr;
+    }
+    *ret_sources = sources;
+    *ret_count = count;
+    TRACE("%u video capture devices.\n", count);
+    return S_OK;
+}
