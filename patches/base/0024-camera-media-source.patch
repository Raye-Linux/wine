+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (capture->state == CAPTURE_STOPPED)
+        hr = MF_E_MEDIA_SOURCE_WRONGSTATE;
+    else if (!capture->stream_active)
+        hr = MF_E_INVALIDREQUEST;
+    else if (!(entry = calloc(1, sizeof(*entry))))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        if ((entry->token = token))
+            IUnknown_AddRef(token);
+        list_add_tail(&capture->tokens, &entry->entry);
+        SetEvent(capture->wake);
+    }
+    LeaveCriticalSection(&capture->cs);
+    return hr;
