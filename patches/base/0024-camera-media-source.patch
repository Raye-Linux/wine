+struct camera_mode
+{
+    struct wg_camera_mode info;
+    GstCaps *src_caps;  /* what the device is asked for */
+    GstCaps *out_caps;  /* what the program gets */
+    bool decode;
+};
+
+struct camera_device
+{
+    char path[64];      /* empty for the test camera */
+    WCHAR name[128];
+    WCHAR link[192];
+    struct camera_mode modes[MAX_MODES];
+    UINT32 mode_count;
+};
+
+struct wg_camera
+{
+    struct camera_device device;
+    bool test;
+
+    GstElement *pipeline;
+    GstPad *my_sink;
+    const struct camera_mode *mode;
+    GstCaps *out_caps;      /* mode->out_caps at the rate asked for */
+    UINT32 fps_n, fps_d;
+
+    GMutex lock;
+    GCond cond;
+    GstBuffer *buffer;
+    GstVideoInfo info;
+    bool running, error;
+};
+
+static GMutex devices_lock;
+static struct camera_device *devices;
+static UINT32 device_count;
+
+static const struct
+{
+    const char *gst;
+    const GUID *subtype;
+}
+raw_formats[] =
+{
+    {"NV12", &MFVideoFormat_NV12},
+    {"YUY2", &MFVideoFormat_YUY2},
+    {"I420", &MFVideoFormat_I420},
+    {"YV12", &MFVideoFormat_YV12},
+    {"UYVY", &MFVideoFormat_UYVY},
+    {"BGRx", &MFVideoFormat_RGB32},
+    {"BGR",  &MFVideoFormat_RGB24},
+};
+
+static void free_modes(struct camera_device *device)
+{
+    UINT32 i;
+
+    for (i = 0; i < device->mode_count; ++i)
+    {
+        gst_caps_unref(device->modes[i].src_caps);
+        gst_caps_unref(device->modes[i].out_caps);
+    }
+    device->mode_count = 0;
+}
+
+static void free_devices(void)
+{
+    UINT32 i;
+
+    for (i = 0; i < device_count; ++i)
+        free_modes(&devices[i]);
+    free(devices);
+    devices = NULL;
+    device_count = 0;
+}
+
+static bool get_int_max(const GstStructure *structure, const char *field, int *out)
+{
+    const GValue *value = gst_structure_get_value(structure, field);
+    unsigned int i;
+
+    if (!value)
+        return false;
+    if (G_VALUE_HOLDS_INT(value))
+        *out = g_value_get_int(value);
+    else if (GST_VALUE_HOLDS_INT_RANGE(value))
+        *out = gst_value_get_int_range_max(value);
+    else if (GST_VALUE_HOLDS_LIST(value))
+    {
+        *out = 0;
+        for (i = 0; i < gst_value_list_get_size(value); ++i)
+        {
+            const GValue *item = gst_value_list_get_value(value, i);
+            if (G_VALUE_HOLDS_INT(item) && g_value_get_int(item) > *out)
+                *out = g_value_get_int(item);
+        }
+    }
+    else
+        return false;
+    return *out > 0;
+}
+
+static void update_rate(const GValue *value, GValue *max, GValue *min)
+{
+    if (!gst_value_get_fraction_numerator(value))
+        return;
+    if (!G_IS_VALUE(max) || gst_value_compare(value, max) == GST_VALUE_GREATER_THAN)
+    {
+        if (G_IS_VALUE(max)) g_value_unset(max);
+        g_value_init(max, GST_TYPE_FRACTION);
+        g_value_copy(value, max);
+    }
+    if (!G_IS_VALUE(min) || gst_value_compare(value, min) == GST_VALUE_LESS_THAN)
+    {
+        if (G_IS_VALUE(min)) g_value_unset(min);
+        g_value_init(min, GST_TYPE_FRACTION);
+        g_value_copy(value, min);
+    }
+}
+
+static void get_rates(const GstStructure *structure, struct wg_camera_mode *info)
+{
+    const GValue *value = gst_structure_get_value(structure, "framerate");
+    GValue max = G_VALUE_INIT, min = G_VALUE_INIT;
+    unsigned int i;
+
+    if (value && GST_VALUE_HOLDS_FRACTION(value))
+        update_rate(value, &max, &min);
+    else if (value && GST_VALUE_HOLDS_FRACTION_RANGE(value))
+    {
+        update_rate(gst_value_get_fraction_range_max(value), &max, &min);
+        update_rate(gst_value_get_fraction_range_min(value), &max, &min);
+    }
+    else if (value && GST_VALUE_HOLDS_LIST(value))
+    {
+        for (i = 0; i < gst_value_list_get_size(value); ++i)
+        {
+            const GValue *item = gst_value_list_get_value(value, i);
+            if (GST_VALUE_HOLDS_FRACTION(item))
+                update_rate(item, &max, &min);
+        }
+    }
+
+    /* no rate, or only "variable": say 30, like most cameras */
+    info->fps_n = info->fps_min_n = 30;
+    info->fps_d = info->fps_min_d = 1;
+    if (G_IS_VALUE(&max))
+    {
+        info->fps_n = gst_value_get_fraction_numerator(&max);
+        info->fps_d = gst_value_get_fraction_denominator(&max);
+        g_value_unset(&max);
+    }
+    if (G_IS_VALUE(&min))
+    {
+        info->fps_min_n = gst_value_get_fraction_numerator(&min);
+        info->fps_min_d = gst_value_get_fraction_denominator(&min);
+        g_value_unset(&min);
+    }
+}
+
+/* Each rate a camera lists is a type of its own, as on Windows, so a
+ * program picks 15 or 30 frames a second the way it picks a size. Highest
+ * first; a continuous range only gives its highest. */
+static unsigned int get_rate_list(const GstStructure *structure, const struct wg_camera_mode *range,
+        UINT32 rates[][2])
+{
+    const GValue *value = gst_structure_get_value(structure, "framerate");
+    unsigned int i, j, count = 0;
+
+    if (value && GST_VALUE_HOLDS_LIST(value))
+    {
+        for (i = 0; i < gst_value_list_get_size(value) && count < MAX_RATES; ++i)
+        {
+            const GValue *item = gst_value_list_get_value(value, i);
+            UINT32 n, d;
+
+            if (!GST_VALUE_HOLDS_FRACTION(item) || !(n = gst_value_get_fraction_numerator(item)))
+                continue;
+            d = gst_value_get_fraction_denominator(item);
+            for (j = 0; j < count; ++j)
+                if ((UINT64)rates[j][0] * d == (UINT64)n * rates[j][1]) break;
+            if (j < count)
+                continue;
+            for (j = count; j > 0 && (UINT64)rates[j - 1][0] * d < (UINT64)n * rates[j - 1][1]; --j)
+            {
+                rates[j][0] = rates[j - 1][0];
+                rates[j][1] = rates[j - 1][1];
+            }
+            rates[j][0] = n;
+            rates[j][1] = d;
+            count++;
+        }
+    }
+    if (!count)
+    {
+        rates[0][0] = range->fps_n;
+        rates[0][1] = range->fps_d;
+        count = 1;
+    }
+    return count;
+}
+
+static struct camera_mode *find_mode(struct camera_device *device, const GUID *subtype,
+        UINT32 width, UINT32 height, UINT32 fps_n, UINT32 fps_d)
+{
+    UINT32 i;
+
+    for (i = 0; i < device->mode_count; ++i)
+    {
+        struct wg_camera_mode *info = &device->modes[i].info;
+        if (IsEqualGUID(&info->subtype, subtype) && info->width == width && info->height == height
+                && (UINT64)info->fps_n * fps_d == (UINT64)fps_n * info->fps_d)
+            return &device->modes[i];
+    }
+    return NULL;
+}
+
+static bool raw_info_from_caps(GstVideoInfo *info, GstCaps *caps)
+{
+    if (!gst_structure_has_name(gst_caps_get_structure(caps, 0), "video/x-raw")
+            || !gst_video_info_from_caps(info, caps))
+    {
+        gst_video_info_init(info);
+        return false;
+    }
+    return true;
+}
+
+static void add_mode(struct camera_device *device, const GUID *subtype, const char *format,
+        const struct wg_camera_mode *rates, UINT32 width, UINT32 height, bool decode)
+{
+    struct camera_mode *mode;
+    GstVideoInfo video_info;
+
+    if (device->mode_count == MAX_MODES || find_mode(device, subtype, width, height, rates->fps_n, rates->fps_d))
+        return;
+    mode = &device->modes[device->mode_count];
+    memset(mode, 0, sizeof(*mode));
+    mode->info = *rates;
+    mode->info.subtype = *subtype;
+    mode->info.width = width;
+    mode->info.height = height;
+    mode->decode = decode;
+
+    if (decode || !format)
+        mode->src_caps = gst_caps_new_simple("image/jpeg", "width", G_TYPE_INT, width,
+                "height", G_TYPE_INT, height, "framerate", GST_TYPE_FRACTION, rates->fps_n, rates->fps_d, NULL);
+    else
+        mode->src_caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, format,
+                "width", G_TYPE_INT, width, "height", G_TYPE_INT, height,
+                "framerate", GST_TYPE_FRACTION, rates->fps_n, rates->fps_d, NULL);
+
+    if (decode)
+        mode->out_caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "NV12",
+                "width", G_TYPE_INT, width, "height", G_TYPE_INT, height,
+                "framerate", GST_TYPE_FRACTION, rates->fps_n, rates->fps_d, NULL);
+    else
+        mode->out_caps = gst_caps_ref(mode->src_caps);
+
+    /* raw frames go out tightly packed, the way Media Foundation lays them */
+    if (raw_info_from_caps(&video_info, mode->out_caps))
+    {
+        mode->info.sample_size = video_info.size;
+        mode->info.stride = video_info.stride[0];
+    }
+    device->mode_count++;
+}
+
+static void add_modes(struct camera_device *device, GstCaps *caps)
+{
+    struct camera_device jpeg = {0};
+    unsigned int i, j;
+
+    for (i = 0; i < gst_caps_get_size(caps); ++i)
+    {
+        const GstStructure *structure = gst_caps_get_structure(caps, i);
+        GstCapsFeatures *features = gst_caps_get_features(caps, i);
+        const char *name = gst_structure_get_name(structure), *format;
+        struct wg_camera_mode range, rates;
+        UINT32 rate_list[MAX_RATES][2];
+        unsigned int count, k;
+        int width, height;
+
+        if (features && !gst_caps_features_is_any(features)
+                && !gst_caps_features_is_equal(features, GST_CAPS_FEATURES_MEMORY_SYSTEM_MEMORY))
+            continue;
+        if (!get_int_max(structure, "width", &width) || !get_int_max(structure, "height", &height))
+            continue;
+        get_rates(structure, &range);
+        count = get_rate_list(structure, &range, rate_list);
+
+        for (k = 0; k < count; ++k)
+        {
+            rates = range;
+            rates.fps_n = rate_list[k][0];
+            rates.fps_d = rate_list[k][1];
+
+            if (!strcmp(name, "image/jpeg"))
+            {
+                add_mode(device, &MFVideoFormat_MJPG, NULL, &rates, width, height, false);
+                add_mode(&jpeg, &MFVideoFormat_MJPG, NULL, &rates, width, height, false);
+            }
+            else if (!strcmp(name, "video/x-raw") && (format = gst_structure_get_string(structure, "format")))
+            {
+                for (j = 0; j < ARRAY_SIZE(raw_formats); ++j)
+                {
+                    if (strcmp(format, raw_formats[j].gst)) continue;
+                    add_mode(device, raw_formats[j].subtype, format, &rates, width, height, false);
+                    break;
+                }
+            }
+        }
+    }
+
+    /* Most USB cameras give their large sizes, or their full rate, only as
+     * MJPG. Programs that only take raw frames get those too, decoded. */
+    for (i = 0; i < jpeg.mode_count; ++i)
+    {
+        const struct wg_camera_mode *info = &jpeg.modes[i].info;
+        bool covered = false;
+
+        for (j = 0; j < device->mode_count; ++j)
+        {
+            const struct wg_camera_mode *raw = &device->modes[j].info;
+            if (IsEqualGUID(&raw->subtype, &MFVideoFormat_MJPG)) continue;
+            if (raw->width == info->width && raw->height == info->height
+                    && (UINT64)raw->fps_n * info->fps_d >= (UINT64)info->fps_n * raw->fps_d)
+                covered = true;
+        }
+        if (!covered)
+            add_mode(device, &MFVideoFormat_NV12, "NV12", info, info->width, info->height, true);
+    }
+    free_modes(&jpeg);
+}
+
+/* "Integrated Camera: Integrated C" is how a laptop camera names itself
+ * through V4L2; Windows says "Integrated Camera". */
+static void clean_name(const char *in, char *out, size_t size)
+{
+    const char *colon;
+    size_t len;
+
+    snprintf(out, size, "%s", in);
+    if ((colon = strstr(out, ": ")))
+    {
+        size_t head = colon - out, tail = strlen(colon + 2);
+        if (tail && (!strncmp(out, colon + 2, tail) || (tail >= head && !strncmp(out, colon + 2, head))))
+            out[head] = 0;
+    }
+    len = strlen(out);
+    while (len && out[len - 1] == ' ')
+        out[--len] = 0;
+    if (!len)
+        snprintf(out, size, "%s", "USB Video Device");
+}
+
+static void set_wide(WCHAR *dst, size_t count, const char *src)
+{
+    DWORD len = ntdll_umbstowcs(src, strlen(src), dst, count - 1);
+    dst[len] = 0;
+}
+
+static struct camera_device *new_device(void)
+{
+    struct camera_device *list;
+
+    if (device_count == MAX_CAMERAS || !(list = realloc(devices, (device_count + 1) * sizeof(*devices))))
+        return NULL;
+    devices = list;
+    memset(&devices[device_count], 0, sizeof(*devices));
+    return &devices[device_count];
+}
+
+static void add_v4l2_device(GstDevice *gst_device)
+{
+    const char *path, *vendor, *product, *bus_path;
+    struct camera_device *device;
+    GstStructure *props;
+    char name[128], link[192];
+    gchar *display, *lower;
+    GstCaps *caps;
+
+    if (!gst_device_has_classes(gst_device, "Video/Source"))
+        return;
+    if (!(props = gst_device_get_properties(gst_device)))
+        return;
+    if (!(path = gst_structure_get_string(props, "device.path"))
+            && !(path = gst_structure_get_string(props, "api.v4l2.path")))
+        goto done;
+    if (!(device = new_device()))
+        goto done;
+    snprintf(device->path, sizeof(device->path), "%s", path);
+
+    if ((caps = gst_device_get_caps(gst_device)))
+    {
+        add_modes(device, caps);
+        gst_caps_unref(caps);
+    }
+    /* infrared face login cameras only give GREY: nothing a program can show */
+    if (!device->mode_count)
+        goto done;
+
+    display = gst_device_get_display_name(gst_device);
+    clean_name(display ? display : "", name, sizeof(name));
+    g_free(display);
+    set_wide(device->name, ARRAY_SIZE(device->name), name);
+
+    vendor = gst_structure_get_string(props, "device.vendor.id");
+    product = gst_structure_get_string(props, "device.product.id");
+    if (!(bus_path = gst_structure_get_string(props, "device.bus_path")))
+        bus_path = path;
+    if (vendor && product && strlen(vendor) == 4 && strlen(product) == 4)
+        snprintf(link, sizeof(link), "\\\\?\\usb#vid_%s&pid_%s&mi_00#7&%08x&0&0000"
+                "#{e5323777-f976-4f5b-9b55-b94699c46e44}\\global", vendor, product, g_str_hash(bus_path));
+    else
+        snprintf(link, sizeof(link), "\\\\?\\root#camera#%08x#{e5323777-f976-4f5b-9b55-b94699c46e44}\\global",
+                g_str_hash(path));
+    lower = g_ascii_strdown(link, -1);
+    set_wide(device->link, ARRAY_SIZE(device->link), lower);
+    g_free(lower);
+    device_count++;
+
+done:
+    gst_structure_free(props);
+}
+
+/* A camera made of a test pattern, so the whole path can be checked on a
+ * machine without one. */
+static void add_test_device(const char *name)
+{
+    static const char modes[] =
+            "video/x-raw, format=YUY2, width=640, height=480, framerate={ 30/1, 15/1 }; "
+            "video/x-raw, format=NV12, width=1280, height=720, framerate=30/1; "
+            "image/jpeg, width=1280, height=720, framerate=30/1; "
+            "image/jpeg, width=1920, height=1080, framerate=30/1";
+    struct camera_device *device;
+    GstCaps *caps;
+
+    if (!(device = new_device()) || !(caps = gst_caps_from_string(modes)))
+        return;
+    add_modes(device, caps);
+    gst_caps_unref(caps);
+    set_wide(device->name, ARRAY_SIZE(device->name), name);
+    set_wide(device->link, ARRAY_SIZE(device->link),
+            "\\\\?\\root#camera#test#{e5323777-f976-4f5b-9b55-b94699c46e44}\\global");
+    device_count++;
+}
+
+NTSTATUS wg_camera_enum(void *args)
+{
+    struct wg_camera_enum_params *params = args;
+    GstDeviceProvider *provider;
+    const char *test;
+    GList *list, *l;
+
+    g_mutex_lock(&devices_lock);
+    free_devices();
+
+    if ((test = getenv("WINE_GST_TEST_CAMERA")) && *test)
+        add_test_device(test);
+
+    if ((provider = gst_device_provider_factory_get_by_name("v4l2deviceprovider")))
+    {
+        list = gst_device_provider_get_devices(provider);
+        for (l = list; l; l = l->next)
+            add_v4l2_device(l->data);
+        g_list_free_full(list, gst_object_unref);
+        gst_object_unref(provider);
+    }
+    else
+        GST_WARNING("No v4l2 device provider, are the GStreamer \"good\" plugins installed?");
+
+    params->count = device_count;
+    g_mutex_unlock(&devices_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wg_camera_get_device(void *args)
+{
+    struct wg_camera_get_device_params *params = args;
+    NTSTATUS status = STATUS_NO_MORE_ENTRIES;
+
+    g_mutex_lock(&devices_lock);
+    if (params->index < device_count)
+    {
+        memcpy(params->name, devices[params->index].name, sizeof(params->name));
+        memcpy(params->link, devices[params->index].link, sizeof(params->link));
+        params->mode_count = devices[params->index].mode_count;
+        status = STATUS_SUCCESS;
+    }
+    g_mutex_unlock(&devices_lock);
+    return status;
+}
+
+static struct wg_camera *get_camera(wg_camera_t camera)
+{
+    return (struct wg_camera *)(ULONG_PTR)camera;
+}
+
+NTSTATUS wg_camera_create(void *args)
+{
+    struct wg_camera_create_params *params = args;
+    struct wg_camera *camera = NULL;
+    UINT32 i, j;
+
+    params->camera = 0;
+    g_mutex_lock(&devices_lock);
+    for (i = 0; i < device_count; ++i)
+    {
+        if (memcmp(devices[i].link, params->link, sizeof(params->link))) continue;
+        if (!(camera = calloc(1, sizeof(*camera)))) break;
+        camera->device = devices[i];
+        for (j = 0; j < camera->device.mode_count; ++j)
+        {
+            gst_caps_ref(camera->device.modes[j].src_caps);
+            gst_caps_ref(camera->device.modes[j].out_caps);
+        }
+        camera->test = !camera->device.path[0];
+        break;
+    }
+    g_mutex_unlock(&devices_lock);
+
+    if (!camera)
+        return STATUS_NOT_FOUND;
+    g_mutex_init(&camera->lock);
+    g_cond_init(&camera->cond);
+    params->camera = (ULONG_PTR)camera;
+    params->mode_count = camera->device.mode_count;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wg_camera_get_mode(void *args)
+{
+    struct wg_camera_get_mode_params *params = args;
+    struct wg_camera *camera = get_camera(params->camera);
+
+    if (params->index >= camera->device.mode_count)
+        return STATUS_NO_MORE_ENTRIES;
+    params->mode = camera->device.modes[params->index].info;
+    return STATUS_SUCCESS;
+}
+
+static GstFlowReturn sink_chain_cb(GstPad *pad, GstObject *parent, GstBuffer *buffer)
+{
+    struct wg_camera *camera = gst_pad_get_element_private(pad);
+
+    g_mutex_lock(&camera->lock);
+    /* a live source: keep the newest frame only */
+    if (camera->buffer)
+        gst_buffer_unref(camera->buffer);
+    camera->buffer = buffer;
+    g_cond_broadcast(&camera->cond);
+    g_mutex_unlock(&camera->lock);
+    return GST_FLOW_OK;
+}
+
+static gboolean sink_event_cb(GstPad *pad, GstObject *parent, GstEvent *event)
+{
+    struct wg_camera *camera = gst_pad_get_element_private(pad);
+    GstCaps *caps;
+
+    if (GST_EVENT_TYPE(event) == GST_EVENT_CAPS)
+    {
+        gst_event_parse_caps(event, &caps);
+        g_mutex_lock(&camera->lock);
+        raw_info_from_caps(&camera->info, caps);
+        g_mutex_unlock(&camera->lock);
+    }
+    else if (GST_EVENT_TYPE(event) == GST_EVENT_EOS)
+    {
+        g_mutex_lock(&camera->lock);
+        camera->error = true;
+        g_cond_broadcast(&camera->cond);
+        g_mutex_unlock(&camera->lock);
+    }
+    gst_event_unref(event);
+    return TRUE;
+}
+
+static gboolean sink_query_cb(GstPad *pad, GstObject *parent, GstQuery *query)
+{
+    struct wg_camera *camera = gst_pad_get_element_private(pad);
+    GstCaps *filter, *caps;
+
+    switch (GST_QUERY_TYPE(query))
+    {
+    case GST_QUERY_CAPS:
+        gst_query_parse_caps(query, &filter);
+        if (filter)
+            caps = gst_caps_intersect_full(filter, camera->out_caps, GST_CAPS_INTERSECT_FIRST);
+        else
+            caps = gst_caps_ref(camera->out_caps);
+        gst_query_set_caps_result(query, caps);
+        gst_caps_unref(caps);
+        return TRUE;
+    case GST_QUERY_ACCEPT_CAPS:
+        gst_query_parse_accept_caps(query, &caps);
+        gst_query_set_accept_caps_result(query, gst_caps_can_intersect(caps, camera->out_caps));
+        return TRUE;
+    default:
+        return gst_pad_query_default(pad, parent, query);
+    }
+}
+
+static GstElement *create_source(struct wg_camera *camera, const struct camera_mode *mode)
+{
+    GstElement *bin, *src, *filter, *enc, *first = NULL, *last = NULL;
+    GstCaps *caps;
+    GstPad *pad;
+
+    if (!camera->test)
+    {
+        if ((src = create_element("v4l2src", "good")))
+            g_object_set(src, "device", camera->device.path, NULL);
+        return src;
+    }
+
+    bin = gst_bin_new(NULL);
+    if (!(src = create_element("videotestsrc", "base")))
+        goto fail;
+    g_object_set(src, "is-live", TRUE, "pattern", 18 /* ball */, NULL);
+    if (!append_element(bin, src, &first, &last))
+        goto fail;
+    if (!mode->decode && !IsEqualGUID(&mode->info.subtype, &MFVideoFormat_MJPG))
+        goto done;
+
+    if (!(filter = create_element("capsfilter", "base")))
+        goto fail;
+    caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "I420",
+            "width", G_TYPE_INT, mode->info.width, "height", G_TYPE_INT, mode->info.height, NULL);
+    g_object_set(filter, "caps", caps, NULL);
+    gst_caps_unref(caps);
+    if (!append_element(bin, filter, &first, &last)
+            || !(enc = create_element("jpegenc", "good"))
+            || !append_element(bin, enc, &first, &last))
+        goto fail;
+
+done:
+    pad = gst_element_get_static_pad(last, "src");
+    gst_element_add_pad(bin, gst_ghost_pad_new("src", pad));
+    gst_object_unref(pad);
+    return bin;
+
+fail:
+    gst_object_unref(bin);
+    return NULL;
+}
+
+static void stop_pipeline(struct wg_camera *camera)
+{
+    GstElement *pipeline;
+
+    g_mutex_lock(&camera->lock);
+    camera->running = false;
+    pipeline = camera->pipeline;
+    camera->pipeline = NULL;
+    if (camera->buffer)
+        gst_buffer_unref(camera->buffer);
+    camera->buffer = NULL;
+    g_cond_broadcast(&camera->cond);
+    g_mutex_unlock(&camera->lock);
+
+    if (pipeline)
+    {
+        gst_element_set_state(pipeline, GST_STATE_NULL);
+        gst_object_unref(pipeline);
+    }
+    if (camera->my_sink)
+    {
+        gst_pad_set_active(camera->my_sink, FALSE);
+        gst_object_unref(camera->my_sink);
+        camera->my_sink = NULL;
+    }
+    camera->mode = NULL;
+
+    g_mutex_lock(&camera->lock);
+    if (camera->buffer)
+        gst_buffer_unref(camera->buffer);
+    camera->buffer = NULL;
+    camera->error = false;
+    g_mutex_unlock(&camera->lock);
+}
+
+/* An unplugged camera or one another program holds: v4l2src posts an error. */
+static bool bus_has_error(GstBus *bus, const char *path)
+{
+    GstMessage *message;
+    GError *error;
+    gchar *debug;
+
+    if (!bus || !(message = gst_bus_pop_filtered(bus, GST_MESSAGE_ERROR)))
+        return false;
+    gst_message_parse_error(message, &error, &debug);
+    GST_ERROR("Camera %s: %s (%s).", path, error->message, debug);
+    g_error_free(error);
+    g_free(debug);
+    gst_message_unref(message);
+    return true;
+}
+
+NTSTATUS wg_camera_start(void *args)
+{
+    struct wg_camera_start_params *params = args;
+    struct wg_camera *camera = get_camera(params->camera);
+    GstElement *first = NULL, *last = NULL, *element;
+    const struct camera_mode *mode;
+    GstCaps *src_caps, *out_caps;
+    GstStateChangeReturn ret;
+    GstElement *pipeline;
+    UINT32 fps_n, fps_d;
+    bool failed;
+    GstBus *bus;
+
+    if (params->mode >= camera->device.mode_count)
+        return STATUS_INVALID_PARAMETER;
+    mode = &camera->device.modes[params->mode];
+
+    /* a rate the camera can do, or its highest */
+    fps_n = mode->info.fps_n;
+    fps_d = mode->info.fps_d;
+    if (params->fps_n && params->fps_d
+            && (UINT64)params->fps_n * mode->info.fps_d <= (UINT64)mode->info.fps_n * params->fps_d
+            && (UINT64)params->fps_n * mode->info.fps_min_d >= (UINT64)mode->info.fps_min_n * params->fps_d)
+    {
+        fps_n = params->fps_n;
+        fps_d = params->fps_d;
+    }
+
+    params->fps_n = fps_n;
+    params->fps_d = fps_d;
+    if (camera->pipeline && camera->mode == mode && camera->fps_n == fps_n && camera->fps_d == fps_d)
+        return STATUS_SUCCESS;
+    stop_pipeline(camera);
+
+    src_caps = gst_caps_copy(mode->src_caps);
+    out_caps = gst_caps_copy(mode->out_caps);
+    gst_caps_set_simple(src_caps, "framerate", GST_TYPE_FRACTION, fps_n, fps_d, NULL);
+    gst_caps_set_simple(out_caps, "framerate", GST_TYPE_FRACTION, fps_n, fps_d, NULL);
+    if (camera->out_caps)
+        gst_caps_unref(camera->out_caps);
+    camera->out_caps = out_caps;
+    camera->mode = mode;
+    camera->fps_n = fps_n;
+    camera->fps_d = fps_d;
+
+    pipeline = gst_pipeline_new("wg_camera");
+    if (!(element = create_source(camera, mode)) || !append_element(pipeline, element, &first, &last))
+        goto fail;
+    if (!(element = create_element("capsfilter", "base")) || !append_element(pipeline, element, &first, &last))
+        goto fail;
+    g_object_set(element, "caps", src_caps, NULL);
+    gst_caps_unref(src_caps);
+    src_caps = NULL;
+    if (mode->decode)
+    {
+        if (!(element = create_element("jpegdec", "good")) || !append_element(pipeline, element, &first, &last)
+                || !(element = create_element("videoconvert", "base"))
+                || !append_element(pipeline, element, &first, &last))
+            goto fail;
+    }
+
+    camera->my_sink = gst_pad_new("sink", GST_PAD_SINK);
+    gst_pad_set_element_private(camera->my_sink, camera);
+    gst_pad_set_chain_function(camera->my_sink, sink_chain_cb);
+    gst_pad_set_event_function(camera->my_sink, sink_event_cb);
+    gst_pad_set_query_function(camera->my_sink, sink_query_cb);
+    if (!link_element_to_sink(last, camera->my_sink) || !gst_pad_set_active(camera->my_sink, TRUE))
+        goto fail;
+
+    g_mutex_lock(&camera->lock);
+    gst_video_info_init(&camera->info);
+    camera->pipeline = pipeline;
+    camera->running = true;
+    g_mutex_unlock(&camera->lock);
+
+    gst_element_set_state(pipeline, GST_STATE_PLAYING);
+    ret = gst_element_get_state(pipeline, NULL, NULL, 2 * GST_SECOND);
+    bus = gst_element_get_bus(pipeline);
+    failed = bus_has_error(bus, camera->device.path);
+    gst_object_unref(bus);
+    if (ret == GST_STATE_CHANGE_FAILURE || failed)
+    {
+        GST_ERROR("Failed to start camera %s.", camera->device.path);
+        stop_pipeline(camera);
+        return STATUS_DEVICE_BUSY;
+    }
+    return STATUS_SUCCESS;
+
+fail:
+    if (src_caps)
+        gst_caps_unref(src_caps);
+    if (!camera->pipeline)
+        gst_object_unref(pipeline);
+    stop_pipeline(camera);
+    return STATUS_UNSUCCESSFUL;
+}
+
+NTSTATUS wg_camera_stop(void *args)
+{
+    struct wg_camera *camera = get_camera(*(wg_camera_t *)args);
+
+    stop_pipeline(camera);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wg_camera_read(void *args)
+{
+    struct wg_camera_read_params *params = args;
+    struct wg_camera *camera = get_camera(params->camera);
+    BYTE *data = (BYTE *)(ULONG_PTR)params->data;
+    gint64 deadline = g_get_monotonic_time() + params->timeout_ms * G_TIME_SPAN_MILLISECOND;
+    GstVideoFrame src, dst;
+    GstBuffer *buffer, *out;
+    GstBus *bus = NULL;
+    GstVideoInfo info;
+    bool error, copied;
+
+    params->size = 0;
+    if (!data)
+        return STATUS_INVALID_PARAMETER;
+    g_mutex_lock(&camera->lock);
+    while (!camera->buffer && camera->running && !camera->error)
+        if (!g_cond_wait_until(&camera->cond, &camera->lock, deadline))
+            break;
+    buffer = camera->buffer;
+    camera->buffer = NULL;
+    info = camera->info;
+    error = camera->error;
+    if (!buffer && camera->pipeline)
+        bus = gst_element_get_bus(camera->pipeline);
+    g_mutex_unlock(&camera->lock);
+
+    if (!buffer)
+    {
+        if (bus_has_error(bus, camera->device.path))
+            error = true;
+        if (bus)
+            gst_object_unref(bus);
+        return error ? STATUS_DEVICE_NOT_CONNECTED : STATUS_TIMEOUT;
+    }
+
+    if (GST_BUFFER_PTS_IS_VALID(buffer))
+        params->pts = GST_BUFFER_PTS(buffer) / 100;
+    else
+        params->pts = g_get_monotonic_time() * 10;
+
+    if (GST_VIDEO_INFO_FORMAT(&info) == GST_VIDEO_FORMAT_UNKNOWN)
+    {
+        params->size = gst_buffer_get_size(buffer);
+        if (params->size > params->capacity)
+            goto too_small;
+        gst_buffer_extract(buffer, 0, data, params->size);
+        gst_buffer_unref(buffer);
+        return STATUS_SUCCESS;
+    }
+
+    params->size = info.size;
+    if (params->size > params->capacity)
+        goto too_small;
+    out = gst_buffer_new_wrapped_full(0, data, params->capacity, 0, info.size, NULL, NULL);
+    if (!gst_video_frame_map(&src, &info, buffer, GST_MAP_READ))
+    {
+        gst_buffer_unref(out);
+        gst_buffer_unref(buffer);
+        return STATUS_UNSUCCESSFUL;
+    }
+    copied = gst_video_frame_map(&dst, &info, out, GST_MAP_WRITE);
+    if (copied)
+    {
+        copied = gst_video_frame_copy(&dst, &src);
+        gst_video_frame_unmap(&dst);
+    }
+    gst_video_frame_unmap(&src);
+    gst_buffer_unref(out);
+    gst_buffer_unref(buffer);
+    return copied ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+
+too_small:
+    gst_buffer_unref(buffer);
+    return STATUS_BUFFER_TOO_SMALL;
+}
+
+NTSTATUS wg_camera_destroy(void *args)
+{
+    struct wg_camera *camera = get_camera(*(wg_camera_t *)args);
+
+    stop_pipeline(camera);
+    if (camera->out_caps)
+        gst_caps_unref(camera->out_caps);
+    free_modes(&camera->device);
+    g_cond_clear(&camera->cond);
+    g_mutex_clear(&camera->lock);
+    free(camera);
+    return STATUS_SUCCESS;
+}
