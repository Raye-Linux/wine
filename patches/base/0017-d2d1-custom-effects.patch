+            space == D2D1_COLOR_SPACE_SCRGB ? DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709
+            : DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709, profile, space == D2D1_COLOR_SPACE_CUSTOM ? profile_size : 0,
+            (ID2D1ColorContext1 **)color_context);
 }
 
