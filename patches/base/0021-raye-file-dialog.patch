+ */
+
+/*
+ * The Open, Save and folder dialogs are handed to raye-file-dialog, which
+ * shows the desktop's own dialog. The program's window stays disabled and
+ * keeps repainting while it is up, as with any modal dialog. When the
+ * helper is missing or cannot show anything, the caller draws the usual
+ * dialog. RAYE_FILE_DIALOG=off turns this off, any other value names the
+ * helper.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winnls.h"
+#include "commdlg.h"
+#include "shlobj.h"
+#include "shlwapi.h"
+#include "cdlg.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
+
+#define HELPER "/opt/raye-wine/bin/raye-file-dialog"
+
+struct args
+{
+    char **argv;
+    int count, size;
+};
+
+static void add(struct args *a, const char *text)
+{
+    if (!text) return;
+    if (a->count + 2 > a->size)
+    {
+        a->size = a->size ? a->size * 2 : 32;
+        a->argv = realloc(a->argv, a->size * sizeof(char *));
+    }
+    a->argv[a->count++] = strdup(text);
+    a->argv[a->count] = NULL;
+}
+
+static char *to_utf8(const WCHAR *text)
+{
+    int len = WideCharToMultiByte(CP_UTF8, 0, text, -1, NULL, 0, NULL, NULL);
+    char *out = malloc(len);
+    WideCharToMultiByte(CP_UTF8, 0, text, -1, out, len, NULL, NULL);
+    return out;
+}
+
+static void add_w(struct args *a, const char *key, const WCHAR *value)
+{
+    char *text;
+    if (!value || !*value) return;
+    text = to_utf8(value);
+    add(a, key);
+    add(a, text);
+    free(text);
+}
+
+/* a Windows path as Linux sees it */
+static void add_path(struct args *a, const char *key, const WCHAR *path)
+{
+    char *unix_name;
+    if (!path || !*path) return;
+    if (!(unix_name = wine_get_unix_file_name(path))) return;
+    add(a, key);
+    add(a, unix_name);
+    HeapFree(GetProcessHeap(), 0, unix_name);
+}
+
+static void free_args(struct args *a)
+{
+    int i;
+    for (i = 0; i < a->count; i++) free(a->argv[i]);
+    free(a->argv);
+}
+
+BOOL native_file_dialog_enabled(void)
+{
+    WCHAR value[8];
+    DWORD len = GetEnvironmentVariableW(L"RAYE_FILE_DIALOG", value, ARRAY_SIZE(value));
+    if (len && len < ARRAY_SIZE(value) && (!wcsicmp(value, L"off") || !wcscmp(value, L"0")))
+        return FALSE;
+    return TRUE;
+}
+
+static char *helper_path(void)
+{
+    WCHAR value[MAX_PATH];
+    DWORD len = GetEnvironmentVariableW(L"RAYE_FILE_DIALOG", value, ARRAY_SIZE(value));
+    if (len && len < ARRAY_SIZE(value) && value[0] == '/') return to_utf8(value);
+    return strdup(HELPER);
+}
+
+struct spawn
+{
+    char **argv;
+    NTSTATUS status;
+};
+
+static DWORD WINAPI spawn_thread(void *arg)
+{
+    struct spawn *s = arg;
+    s->status = __wine_unix_spawnvp(s->argv, TRUE);
+    return 0;
+}
+
+/* runs the helper; the program's own windows keep getting their messages */
+static NTSTATUS run_helper(HWND owner, char **argv)
+{
+    struct spawn s = { argv, STATUS_UNSUCCESSFUL };
+    HWND top = owner ? GetAncestor(owner, GA_ROOT) : NULL;
+    BOOL disabled = FALSE, quit = FALSE;
+    WPARAM quit_code = 0;
+    HANDLE thread;
+    MSG msg;
+
+    if (!(thread = CreateThread(NULL, 0, spawn_thread, &s, 0, NULL))) return STATUS_UNSUCCESSFUL;
+    if (top && IsWindowEnabled(top))
+    {
+        EnableWindow(top, FALSE);
+        disabled = TRUE;
+    }
+    while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_ALLINPUT) == WAIT_OBJECT_0 + 1)
+    {
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                continue;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    CloseHandle(thread);
+    if (disabled) EnableWindow(top, TRUE);
+    if (top) SetForegroundWindow(top);
+    if (quit) PostQuitMessage(quit_code);
+    return s.status;
+}
+
+/* Documents, Pictures... of the space are links to the person's own
+ * folders. Linux paths come back from the dialog; inside one of those
+ * folders they are given to the program through the link, so it sees
+ * C:\users\<name>\Documents\... and not the drive of the whole system. */
+struct place
+{
+    char *unix_name;
+    WCHAR dos[MAX_PATH];
+};
+
+static unsigned int get_places(struct place *places, unsigned int max)
+{
+    static const int ids[] = { CSIDL_PERSONAL, CSIDL_MYPICTURES, CSIDL_MYMUSIC, CSIDL_MYVIDEO, CSIDL_DESKTOPDIRECTORY };
+    unsigned int i, n = 0;
+    WCHAR *known;
+
+    for (i = 0; i < ARRAY_SIZE(ids) && n < max; i++)
+        if (SHGetFolderPathW(NULL, ids[i], NULL, SHGFP_TYPE_CURRENT, places[n].dos) == S_OK &&
+            (places[n].unix_name = wine_get_unix_file_name(places[n].dos)))
+            n++;
+    if (n < max && SHGetKnownFolderPath(&FOLDERID_Downloads, 0, NULL, &known) == S_OK)
+    {
+        lstrcpynW(places[n].dos, known, MAX_PATH);
+        if ((places[n].unix_name = wine_get_unix_file_name(known))) n++;
+        CoTaskMemFree(known);
+    }
+    return n;
+}
+
+static WCHAR *dos_name(const char *path, const struct place *places, unsigned int count)
+{
+    unsigned int i, best = count;
+    size_t len, best_len = 0;
+    WCHAR *out, *p;
+    int rest;
+
+    for (i = 0; i < count; i++)
+    {
+        len = strlen(places[i].unix_name);
+        if (len > best_len && !strncmp(path, places[i].unix_name, len) && (path[len] == '/' || !path[len]))
+        {
+            best = i;
+            best_len = len;
+        }
+    }
+    if (best == count) return wine_get_dos_file_name(path);
+
+    rest = MultiByteToWideChar(CP_UTF8, 0, path + best_len, -1, NULL, 0);
+    out = HeapAlloc(GetProcessHeap(), 0, (lstrlenW(places[best].dos) + rest) * sizeof(WCHAR));
+    lstrcpyW(out, places[best].dos);
+    p = out + lstrlenW(out);
+    MultiByteToWideChar(CP_UTF8, 0, path + best_len, -1, p, rest);
+    for (; *p; p++) if (*p == '/') *p = '\\';
+    return out;
+}
+
+static WCHAR *read_answer(const WCHAR *file, UINT *count, const struct place *places, unsigned int place_count)
+{
+    HANDLE h = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    DWORD size, got = 0;
+    char *text, *line, *next;
+    WCHAR *out = NULL, *dos;
+    size_t used = 0;
+
+    *count = 0;
+    if (h == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize(h, NULL);
+    if (size == INVALID_FILE_SIZE || size > 1 << 20)
+    {
+        CloseHandle(h);
+        return NULL;
+    }
+    text = malloc(size + 1);
+    ReadFile(h, text, size, &got, NULL);
+    CloseHandle(h);
+    text[got] = 0;
+
+    out = malloc(sizeof(WCHAR));
+    for (line = text; line && *line; line = next)
+    {
+        if ((next = strchr(line, '\n'))) *next++ = 0;
+        if (line[0] != '/' || !(dos = dos_name(line, places, place_count))) continue;
+        out = realloc(out, (used + lstrlenW(dos) + 2) * sizeof(WCHAR));
+        lstrcpyW(out + used, dos);
+        used += lstrlenW(dos) + 1;
+        (*count)++;
+        HeapFree(GetProcessHeap(), 0, dos);
+    }
+    out[used] = 0;
+    free(text);
+    if (!*count)
+    {
+        free(out);
+        return NULL;
+    }
+    return out;
+}
+
+HRESULT native_file_dialog(HWND owner, const struct native_dialog *req, WCHAR **paths, UINT *count)
+{
+    static const char *modes[] = { "open", "open-multiple", "save", "folder" };
+    WCHAR temp_dir[MAX_PATH], temp_file[MAX_PATH], buf[32];
+    struct args a = { 0 };
+    struct place places[8];
+    unsigned int place_count;
+    char *helper, *item;
+    HANDLE window;
+    NTSTATUS status;
+    UINT i;
+
+    *paths = NULL;
+    *count = 0;
+    if (!GetTempPathW(ARRAY_SIZE(temp_dir), temp_dir) || !GetTempFileNameW(temp_dir, L"rfd", 0, temp_file))
+        return E_NOTIMPL;
+
+    helper = helper_path();
+    add(&a, helper);
+    free(helper);
+    add(&a, "--mode");
+    add(&a, modes[req->mode]);
+    add_path(&a, "--out", temp_file);
+    add_w(&a, "--title", req->title);
+    add_path(&a, "--dir", req->dir);
+    add_w(&a, "--name", req->name);
+    for (i = 0; i < req->filter_count; i++)
+    {
+        WCHAR *pair;
+        if (!req->filter_names[i] || !req->filter_specs[i]) continue;
+        pair = malloc((lstrlenW(req->filter_names[i]) + lstrlenW(req->filter_specs[i]) + 2) * sizeof(WCHAR));
+        lstrcpyW(pair, req->filter_names[i]);
+        lstrcatW(pair, L"|");
+        lstrcatW(pair, req->filter_specs[i]);
+        item = to_utf8(pair);
+        add(&a, "--filter");
+        add(&a, item);
+        free(item);
+        free(pair);
+    }
+    if (req->filter_count)
+    {
+        swprintf(buf, ARRAY_SIZE(buf), L"%u", req->filter_index);
+        add_w(&a, "--filter-index", buf);
+    }
+    if (owner && (window = GetPropW(GetAncestor(owner, GA_ROOT), L"__wine_x11_whole_window")))
+    {
+        swprintf(buf, ARRAY_SIZE(buf), L"%lu", (unsigned long)(ULONG_PTR)window);
+        add_w(&a, "--parent", buf);
+    }
+    status = run_helper(owner, a.argv);
+    free_args(&a);
+    TRACE("helper answered %#lx\n", status);
+
+    if (status == 0)
+    {
+        place_count = get_places(places, ARRAY_SIZE(places));
+        *paths = read_answer(temp_file, count, places, place_count);
+        while (place_count--) HeapFree(GetProcessHeap(), 0, places[place_count].unix_name);
+    }
+    DeleteFileW(temp_file);
+    if (status == 0 && *paths) return S_OK;
+    if (status == 1 || status == 0) return S_FALSE;
+    return E_NOTIMPL;
+}
