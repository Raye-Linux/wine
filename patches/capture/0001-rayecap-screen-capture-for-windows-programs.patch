+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "d3d11.h"
+#include "dxgi1_6.h"
+#include "wine/debug.h"
+
+#include "rayecap.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rayecap);
+
+#define MAX_MONITORS 64
+
+struct duplication
+{
+    IDXGIOutputDuplication IDXGIOutputDuplication_iface;
+    LONG refcount;
+
+    IDXGIOutput *output;
+    ID3D11Device *device;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *texture;
+    HRAYECAP session;
+    HMONITOR monitor;
+    RECT desktop;
+    UINT width, height;
+
+    int stream;
+    UINT64 seq;
+    INT64 cursor_ns;
+    UINT64 cursor_seq;
+    BOOL held, new_image;
+    struct rayecap_frame frame;
+    BYTE *pixels, *scaled;
+    SIZE_T pixels_size;
+};
+
+static inline struct duplication *impl_from_IDXGIOutputDuplication( IDXGIOutputDuplication *iface )
+{
+    return CONTAINING_RECORD( iface, struct duplication, IDXGIOutputDuplication_iface );
+}
+
+struct monitors
+{
+    HMONITOR handles[MAX_MONITORS];
+    RECT rects[MAX_MONITORS];
+    UINT count;
+};
+
+static BOOL CALLBACK add_monitor( HMONITOR monitor, HDC hdc, RECT *rect, LPARAM lparam )
+{
+    struct monitors *list = (struct monitors *)lparam;
+    MONITORINFO info = { .cbSize = sizeof(info) };
+
+    if (list->count == MAX_MONITORS) return FALSE;
+    if (!GetMonitorInfoW( monitor, &info )) return TRUE;
+    list->handles[list->count] = monitor;
+    list->rects[list->count++] = info.rcMonitor;
+    return TRUE;
+}
+
+static int find_stream( struct duplication *dup )
+{
+    struct monitors list = { 0 };
+    RECT rect;
+    UINT i;
+
+    EnumDisplayMonitors( NULL, NULL, add_monitor, (LPARAM)&list );
+    for (i = 0; RayeCaptureStreamInfo( dup->session, i, &rect, NULL ) == S_OK; i++)
+        TRACE( "stream %u at %s\n", i, wine_dbgstr_rect( &rect ) );
+    /* the output's own monitor handle, or its place when a DXGI hands out other handles */
+    for (i = 0; i < list.count; i++)
+        if (list.handles[i] == dup->monitor)
+            return RayeCaptureFindStream( dup->session, list.rects, list.count, i );
+    for (i = 0; i < list.count; i++)
+        if (EqualRect( &list.rects[i], &dup->desktop ))
+            return RayeCaptureFindStream( dup->session, list.rects, list.count, i );
+    return -1;
+}
+
+/* QueryPerformanceCounter counts CLOCK_MONOTONIC here */
+static LONGLONG qpc_time( INT64 ns )
+{
+    LARGE_INTEGER freq;
+
+    QueryPerformanceFrequency( &freq );
+    return ns / 1000000000 * freq.QuadPart + ns % 1000000000 * freq.QuadPart / 1000000000;
+}
+
+static HRESULT create_texture( struct duplication *dup )
+{
+    D3D11_TEXTURE2D_DESC desc =
+    {
+        .Width = dup->width,
+        .Height = dup->height,
+        .MipLevels = 1,
+        .ArraySize = 1,
+        .Format = DXGI_FORMAT_B8G8R8A8_UNORM,
+        .SampleDesc.Count = 1,
+        .Usage = D3D11_USAGE_DEFAULT,
+        .BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET,
+    };
+
+    return ID3D11Device_CreateTexture2D( dup->device, &desc, NULL, &dup->texture );
+}
+
+/* a screen at another scale than the program thinks: nearest pixel is enough */
+static void scale_image( const BYTE *src, UINT src_width, UINT src_height, BYTE *dst, UINT width, UINT height )
+{
+    UINT x, y;
+
+    for (y = 0; y < height; y++)
+    {
+        const DWORD *row = (const DWORD *)(src + (SIZE_T)(y * src_height / height) * src_width * 4);
+        DWORD *out = (DWORD *)(dst + (SIZE_T)y * width * 4);
+        for (x = 0; x < width; x++) out[x] = row[x * src_width / width];
+    }
+}
+
+static HRESULT upload_image( struct duplication *dup, const struct rayecap_frame *frame )
+{
+    RECT src = { 0, 0, frame->width, frame->height };
+    SIZE_T size = (SIZE_T)frame->width * frame->height * 4;
+    const BYTE *bits;
+    HRESULT hr;
+
+    if (dup->pixels_size < size)
+    {
+        free( dup->pixels );
+        if (!(dup->pixels = malloc( size ))) { dup->pixels_size = 0; return E_OUTOFMEMORY; }
+        dup->pixels_size = size;
+    }
+    if (FAILED(hr = RayeCaptureCopy( dup->session, dup->stream, &src, dup->pixels, frame->width * 4, 0, NULL )))
+        return hr;
+
+    bits = dup->pixels;
+    if (frame->width != dup->width || frame->height != dup->height)
+    {
+        if (!dup->scaled && !(dup->scaled = malloc( (SIZE_T)dup->width * dup->height * 4 ))) return E_OUTOFMEMORY;
+        scale_image( dup->pixels, frame->width, frame->height, dup->scaled, dup->width, dup->height );
+        bits = dup->scaled;
+    }
+    ID3D11DeviceContext_UpdateSubresource( dup->context, (ID3D11Resource *)dup->texture, 0, NULL, bits,
+                                           dup->width * 4, 0 );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_QueryInterface( IDXGIOutputDuplication *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IDXGIOutputDuplication ) || IsEqualGUID( iid, &IID_IDXGIObject ) ||
+        IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        IDXGIOutputDuplication_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE duplication_AddRef( IDXGIOutputDuplication *iface )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+    return InterlockedIncrement( &dup->refcount );
+}
+
+static ULONG STDMETHODCALLTYPE duplication_Release( IDXGIOutputDuplication *iface )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+    ULONG refcount = InterlockedDecrement( &dup->refcount );
+
+    if (!refcount)
+    {
+        RayeCaptureClose( dup->session );
+        if (dup->texture) ID3D11Texture2D_Release( dup->texture );
+        ID3D11DeviceContext_Release( dup->context );
+        ID3D11Device_Release( dup->device );
+        IDXGIOutput_Release( dup->output );
+        free( dup->pixels );
+        free( dup->scaled );
+        free( dup );
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_SetPrivateData( IDXGIOutputDuplication *iface, REFGUID guid,
+                                                             UINT size, const void *data )
+{
+    FIXME( "iface %p, guid %s stub!\n", iface, debugstr_guid( guid ) );
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_SetPrivateDataInterface( IDXGIOutputDuplication *iface, REFGUID guid,
+                                                                      const IUnknown *object )
+{
+    FIXME( "iface %p, guid %s stub!\n", iface, debugstr_guid( guid ) );
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_GetPrivateData( IDXGIOutputDuplication *iface, REFGUID guid,
+                                                             UINT *size, void *data )
+{
+    return DXGI_ERROR_NOT_FOUND;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_GetParent( IDXGIOutputDuplication *iface, REFIID iid, void **parent )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+    return IDXGIOutput_QueryInterface( dup->output, iid, parent );
+}
+
+static void STDMETHODCALLTYPE duplication_GetDesc( IDXGIOutputDuplication *iface, DXGI_OUTDUPL_DESC *desc )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+
+    desc->ModeDesc.Width = dup->width;
+    desc->ModeDesc.Height = dup->height;
+    desc->ModeDesc.RefreshRate.Numerator = 60;
+    desc->ModeDesc.RefreshRate.Denominator = 1;
+    desc->ModeDesc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc->ModeDesc.ScanlineOrdering = DXGI_MODE_SCANLINE_ORDER_PROGRESSIVE;
+    desc->ModeDesc.Scaling = DXGI_MODE_SCALING_UNSPECIFIED;
+    desc->Rotation = DXGI_MODE_ROTATION_IDENTITY;
+    desc->DesktopImageInSystemMemory = FALSE;
+}
+
+/*
+ * While the picker is open, or for a screen the user did not share, the
+ * program sees a screen with nothing new: the same answer Windows gives a
+ * still desktop, so programs keep their last image and wait.
+ */
+static HRESULT nothing_new( UINT timeout )
+{
+    Sleep( min( timeout, 500 ) );
+    return DXGI_ERROR_WAIT_TIMEOUT;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_AcquireNextFrame( IDXGIOutputDuplication *iface, UINT timeout,
+                                                               DXGI_OUTDUPL_FRAME_INFO *info, IDXGIResource **resource )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+    struct rayecap_frame frame;
+    UINT state;
+    HRESULT hr;
+
+    TRACE( "iface %p, timeout %u, info %p, resource %p.\n", iface, timeout, info, resource );
+
+    if (!info || !resource) return E_INVALIDARG;
+    *resource = NULL;
+    memset( info, 0, sizeof(*info) );
+    if (dup->held) return DXGI_ERROR_INVALID_CALL;
+
+    if ((state = RayeCaptureState( dup->session )) == RAYECAP_STATE_PENDING)
+    {
+        /* returns as soon as the user has picked */
+        RayeCaptureWait( dup->session, -1, 0, -1, timeout, NULL );
+        state = RayeCaptureState( dup->session );
+    }
+    if (state != RAYECAP_STATE_RUNNING) return nothing_new( timeout );
+    if (dup->stream < 0)
+    {
+        dup->stream = find_stream( dup );
+        TRACE( "screen %p is stream %d\n", dup->monitor, dup->stream );
+        if (dup->stream < 0) return nothing_new( timeout );
+    }
+
+    hr = RayeCaptureWait( dup->session, dup->stream, dup->seq, dup->seq ? dup->cursor_ns : -1, timeout, &frame );
+    if (hr == HRESULT_FROM_WIN32( WAIT_TIMEOUT )) return DXGI_ERROR_WAIT_TIMEOUT;
+    if (FAILED(hr)) return nothing_new( timeout );
+
+    if (!dup->texture && FAILED(hr = create_texture( dup ))) return hr;
+
+    dup->new_image = frame.seq > dup->seq;
+    if (dup->new_image)
+    {
+        if (FAILED(hr = upload_image( dup, &frame ))) return hr;
+        info->LastPresentTime.QuadPart = qpc_time( frame.pts_ns );
+        info->AccumulatedFrames = frame.seq - dup->seq;
+        /* the whole screen counts as changed: one dirty rectangle */
+        info->TotalMetadataBufferSize = sizeof(RECT);
+        dup->seq = frame.seq;
+    }
+    if (frame.cursor_ns != dup->cursor_ns)
+    {
+        info->LastMouseUpdateTime.QuadPart = qpc_time( frame.cursor_ns );
+        info->PointerPosition.Visible = frame.cursor_visible;
+        info->PointerPosition.Position.x = (frame.cursor_x - frame.cursor_hot_x) * (LONG)dup->width / max( frame.width, 1 );
+        info->PointerPosition.Position.y = (frame.cursor_y - frame.cursor_hot_y) * (LONG)dup->height / max( frame.height, 1 );
+        dup->cursor_ns = frame.cursor_ns;
+    }
+    if (frame.cursor_visible && frame.cursor_seq != dup->cursor_seq && frame.cursor_width)
+    {
+        info->PointerShapeBufferSize = frame.cursor_width * frame.cursor_height * 4;
+        dup->cursor_seq = frame.cursor_seq;
+    }
+    dup->frame = frame;
+    dup->held = TRUE;
+    return ID3D11Texture2D_QueryInterface( dup->texture, &IID_IDXGIResource, (void **)resource );
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_GetFrameDirtyRects( IDXGIOutputDuplication *iface, UINT size,
+                                                                 RECT *rects, UINT *required )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+
+    if (!dup->held) return DXGI_ERROR_INVALID_CALL;
+    *required = dup->new_image ? sizeof(RECT) : 0;
+    if (size < *required) return DXGI_ERROR_MORE_DATA;
+    if (dup->new_image) SetRect( rects, 0, 0, dup->width, dup->height );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_GetFrameMoveRects( IDXGIOutputDuplication *iface, UINT size,
+                                                                DXGI_OUTDUPL_MOVE_RECT *rects, UINT *required )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+
+    if (!dup->held) return DXGI_ERROR_INVALID_CALL;
+    *required = 0;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_GetFramePointerShape( IDXGIOutputDuplication *iface, UINT size,
+        void *buffer, UINT *required, DXGI_OUTDUPL_POINTER_SHAPE_INFO *shape )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+    struct rayecap_frame frame;
+    HRESULT hr;
+
+    TRACE( "iface %p, size %u, buffer %p, required %p, shape %p.\n", iface, size, buffer, required, shape );
+
+    if (!required || !shape || (size && !buffer)) return E_INVALIDARG;
+    if (!dup->held) return DXGI_ERROR_INVALID_CALL;
+    *required = dup->frame.cursor_width * dup->frame.cursor_height * 4;
+    if (!*required) return DXGI_ERROR_NOT_FOUND;
+    if (size < *required) return DXGI_ERROR_MORE_DATA;
+    /* the pitch stays the one the size was given for, even if the pointer just changed */
+    if (FAILED(hr = RayeCaptureCopyCursor( dup->session, dup->stream, buffer, dup->frame.cursor_width * 4,
+                                           dup->frame.cursor_width, size / (dup->frame.cursor_width * 4), &frame )))
+    {
+        if (hr == HRESULT_FROM_WIN32( ERROR_MORE_DATA )) return DXGI_ERROR_MORE_DATA;
+        return DXGI_ERROR_NOT_FOUND;
+    }
+    shape->Type = DXGI_OUTDUPL_POINTER_SHAPE_TYPE_COLOR;
+    shape->Width = frame.cursor_width;
+    shape->Height = frame.cursor_height;
+    shape->Pitch = dup->frame.cursor_width * 4;
+    shape->HotSpot.x = frame.cursor_hot_x;
+    shape->HotSpot.y = frame.cursor_hot_y;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_MapDesktopSurface( IDXGIOutputDuplication *iface, DXGI_MAPPED_RECT *rect )
+{
+    return DXGI_ERROR_UNSUPPORTED;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_UnMapDesktopSurface( IDXGIOutputDuplication *iface )
+{
+    return DXGI_ERROR_UNSUPPORTED;
+}
+
+static HRESULT STDMETHODCALLTYPE duplication_ReleaseFrame( IDXGIOutputDuplication *iface )
+{
+    struct duplication *dup = impl_from_IDXGIOutputDuplication( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (!dup->held) return DXGI_ERROR_INVALID_CALL;
+    dup->held = FALSE;
+    return S_OK;
+}
+
+static const IDXGIOutputDuplicationVtbl duplication_vtbl =
+{
+    duplication_QueryInterface,
+    duplication_AddRef,
+    duplication_Release,
+    duplication_SetPrivateData,
+    duplication_SetPrivateDataInterface,
+    duplication_GetPrivateData,
+    duplication_GetParent,
+    duplication_GetDesc,
+    duplication_AcquireNextFrame,
+    duplication_GetFrameDirtyRects,
+    duplication_GetFrameMoveRects,
+    duplication_GetFramePointerShape,
+    duplication_MapDesktopSurface,
+    duplication_UnMapDesktopSurface,
+    duplication_ReleaseFrame,
+};
+
+HRESULT WINAPI RayeCaptureDuplicateOutput( IDXGIOutput *output, IUnknown *device, UINT format_count,
+                                           const int *formats, IDXGIOutputDuplication **out )
+{
+    struct duplication *dup;
+    DXGI_OUTPUT_DESC desc;
+    ID3D11Device *d3d11;
+    UINT i;
+    HRESULT hr;
+
+    TRACE( "output %p, device %p, format_count %u, formats %p, out %p.\n", output, device, format_count, formats, out );
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (!output || !device) return E_INVALIDARG;
+
+    if (format_count)
+    {
+        for (i = 0; i < format_count; i++)
+            if (formats[i] == DXGI_FORMAT_B8G8R8A8_UNORM) break;
+        if (i == format_count) return DXGI_ERROR_UNSUPPORTED;
+    }
+    if (FAILED(IUnknown_QueryInterface( device, &IID_ID3D11Device, (void **)&d3d11 )))
+    {
+        WARN( "only Direct3D 11 devices can duplicate a screen\n" );
+        return E_INVALIDARG;
+    }
+    if (FAILED(hr = IDXGIOutput_GetDesc( output, &desc ))) goto failed;
+
+    if (!(dup = calloc( 1, sizeof(*dup) ))) { hr = E_OUTOFMEMORY; goto failed; }
+    if (FAILED(hr = RayeCaptureOpen( RAYECAP_KIND_SCREENS, &dup->session )))
+    {
+        free( dup );
+        hr = DXGI_ERROR_UNSUPPORTED;
+        goto failed;
+    }
+    if (RayeCaptureState( dup->session ) == RAYECAP_STATE_DENIED)
+    {
+        /* the user already said no in this run */
+        RayeCaptureClose( dup->session );
+        free( dup );
+        hr = E_ACCESSDENIED;
+        goto failed;
+    }
+    dup->IDXGIOutputDuplication_iface.lpVtbl = &duplication_vtbl;
+    dup->refcount = 1;
+    dup->output = output;
+    IDXGIOutput_AddRef( output );
+    dup->device = d3d11;
+    ID3D11Device_GetImmediateContext( d3d11, &dup->context );
+    dup->monitor = desc.Monitor;
+    dup->desktop = desc.DesktopCoordinates;
+    dup->width = desc.DesktopCoordinates.right - desc.DesktopCoordinates.left;
+    dup->height = desc.DesktopCoordinates.bottom - desc.DesktopCoordinates.top;
+    dup->stream = -1;
+    dup->cursor_ns = -1;
+
+    TRACE( "duplicating %s as %p\n", wine_dbgstr_rect( &desc.DesktopCoordinates ), dup );
+    *out = &dup->IDXGIOutputDuplication_iface;
+    return S_OK;
+
+failed:
+    ID3D11Device_Release( d3d11 );
+    return hr;
+}
