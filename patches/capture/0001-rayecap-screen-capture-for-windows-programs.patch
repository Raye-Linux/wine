+++ b/dlls/rayecap/duplication.c
@@ -0,0 +1,486 @@
+/*
+ * IDXGIOutputDuplication over the desktop's screens. Any DXGI can hand
+ * DuplicateOutput over to RayeCaptureDuplicateOutput(): the object only
+ * uses the public Direct3D 11 interface of the program's device.
+ *
+ * Copyright 2026 Raye Linux
