diff --git a/dlls/rayecap/unixlib.c b/dlls/rayecap/unixlib.c
new file mode 100644
index 0000000..754a845
--- /dev/null
+++ b/dlls/rayecap/unixlib.c
@@ -0,0 +1,184 @@
+/*
+ * Unix side of rayecap: hands calls over to libraye-capture.
+ *
+ * Copyright 2026 Raye Linux
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rayecap);
+
+/* from raye-capture.h, kept here so Wine builds without it */
+struct rcap_rect { int x, y, width, height; };
+struct rcap_stream_info { struct rcap_rect rect; unsigned int source; uint32_t node_id; };
+
+static int (*p_open)( int kind, const char *app_key, const char *app_name, void **session );
+static void (*p_unref)( void *session );
+static int (*p_state)( void *session );
+static int (*p_stream_info)( void *session, int index, struct rcap_stream_info *info );
+static int (*p_find_stream)( void *session, const struct rcap_rect *monitors, int count, int monitor );
+static int (*p_wait)( void *session, int index, uint64_t after_seq, int64_t after_cursor_ns, int timeout,
+                      struct rayecap_frame *info );
+static int (*p_copy)( void *session, int index, const struct rcap_rect *src, void *dst, int stride,
+                      unsigned int flags, struct rayecap_frame *info );
+static int (*p_copy_cursor)( void *session, int index, void *dst, int stride, int max_width, int max_height,
+                             struct rayecap_frame *info );
+
+static pthread_once_t load_once = PTHREAD_ONCE_INIT;
+static void *library;
+
+static void load_library(void)
+{
+    if (!(library = dlopen( "libraye-capture.so.1", RTLD_NOW )))
+    {
+        WARN( "screen capture is not available: %s\n", dlerror() );
+        return;
+    }
+#define LOAD(f, name) if (!(f = dlsym( library, name ))) { WARN( "%s missing\n", name ); dlclose( library ); library = NULL; return; }
+    LOAD( p_open, "rcap_session_open" )
+    LOAD( p_unref, "rcap_session_unref" )
+    LOAD( p_state, "rcap_session_state" )
+    LOAD( p_stream_info, "rcap_session_stream_info" )
+    LOAD( p_find_stream, "rcap_session_find_stream" )
+    LOAD( p_wait, "rcap_wait_frame" )
+    LOAD( p_copy, "rcap_copy_frame" )
+    LOAD( p_copy_cursor, "rcap_copy_cursor" )
+#undef LOAD
+}
+
+static void *session( UINT64 handle )
+{
+    return (void *)(ULONG_PTR)handle;
+}
+
+static NTSTATUS rayecap_open( void *args )
+{
+    struct open_params *params = args;
+    void *s;
+
+    pthread_once( &load_once, load_library );
+    if (!library) return STATUS_NOT_SUPPORTED;
+    if (p_open( params->kind, params->app_key, params->app_name, &s )) return STATUS_UNSUCCESSFUL;
+    params->handle = (ULONG_PTR)s;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_close( void *args )
+{
+    struct handle_params *params = args;
+    p_unref( session( params->handle ) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_state( void *args )
+{
+    struct handle_params *params = args;
+    params->state = p_state( session( params->handle ) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_find( void *args )
+{
+    struct find_params *params = args;
+    struct rcap_rect rects[64];
+    UINT i, count = min( params->count, ARRAY_SIZE(rects) );
+
+    for (i = 0; i < count; i++)
+    {
+        rects[i].x = params->monitors[i].left;
+        rects[i].y = params->monitors[i].top;
+        rects[i].width = params->monitors[i].right - params->monitors[i].left;
+        rects[i].height = params->monitors[i].bottom - params->monitors[i].top;
+    }
+    params->stream = p_find_stream( session( params->handle ), rects, count, params->monitor );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_stream_info( void *args )
+{
+    struct stream_params *params = args;
+    struct rcap_stream_info info;
+
+    if ((params->result = p_stream_info( session( params->handle ), params->stream, &info ))) return STATUS_SUCCESS;
+    params->rect.left = info.rect.x;
+    params->rect.top = info.rect.y;
+    params->rect.right = info.rect.x + info.rect.width;
+    params->rect.bottom = info.rect.y + info.rect.height;
+    params->source = info.source;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_wait( void *args )
+{
+    struct wait_params *params = args;
+
+    /* INFINITE and other huge waits mean no limit */
+    params->result = p_wait( session( params->handle ), params->stream, params->after_seq,
+                             params->after_cursor_ns, params->timeout > INT_MAX ? -1 : (int)params->timeout,
+                             &params->frame );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_copy( void *args )
+{
+    struct copy_params *params = args;
+    struct rcap_rect src = { params->src.left, params->src.top, params->src.right - params->src.left,
+                             params->src.bottom - params->src.top };
+
+    params->result = p_copy( session( params->handle ), params->stream, &src, params->dst, params->pitch,
+                             params->flags, &params->frame );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS rayecap_copy_cursor( void *args )
+{
+    struct cursor_params *params = args;
+
+    params->result = p_copy_cursor( session( params->handle ), params->stream, params->dst, params->pitch,
+                                    params->max_width, params->max_height, &params->frame );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    rayecap_open,
+    rayecap_close,
+    rayecap_state,
+    rayecap_find,
+    rayecap_stream_info,
+    rayecap_wait,
+    rayecap_copy,
+    rayecap_copy_cursor,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
