+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __RAYECAP_H
+#define __RAYECAP_H
+
+#define RAYECAP_KIND_SCREENS 1
+#define RAYECAP_KIND_PICK    2
+
+#define RAYECAP_STATE_PENDING 0
+#define RAYECAP_STATE_RUNNING 1
+#define RAYECAP_STATE_DENIED  2
+#define RAYECAP_STATE_CLOSED  3
+
+#define RAYECAP_COPY_CURSOR 0x1
+
+/* same layout as struct rcap_frame_info */
+struct rayecap_frame
+{
+    int width, height;
+    UINT64 seq;
+    INT64 pts_ns;
+    INT64 arrival_ns;
+    int cursor_visible;
+    int cursor_x, cursor_y;
+    int cursor_hot_x, cursor_hot_y;
+    int cursor_width, cursor_height;
+    UINT64 cursor_seq;
+    INT64 cursor_ns;
+};
+
+#ifndef WINE_UNIX_LIB
+
+typedef struct rayecap_session *HRAYECAP;
+
+HRESULT WINAPI RayeCaptureOpen( UINT kind, HRAYECAP *session );
+void    WINAPI RayeCaptureClose( HRAYECAP session );
+UINT    WINAPI RayeCaptureState( HRAYECAP session );
+int     WINAPI RayeCaptureFindStream( HRAYECAP session, const RECT *monitors, UINT count, UINT monitor );
+HRESULT WINAPI RayeCaptureStreamInfo( HRAYECAP session, int stream, RECT *rect, UINT *source );
+HRESULT WINAPI RayeCaptureWait( HRAYECAP session, int stream, UINT64 after_seq, INT64 after_cursor_ns,
+                                UINT timeout, struct rayecap_frame *frame );
+HRESULT WINAPI RayeCaptureCopy( HRAYECAP session, int stream, const RECT *src, void *dst, UINT pitch,
+                                UINT flags, struct rayecap_frame *frame );
+HRESULT WINAPI RayeCaptureCopyCursor( HRAYECAP session, int stream, void *dst, UINT pitch,
+                                      UINT max_width, UINT max_height, struct rayecap_frame *frame );
+
+/* what IDXGIOutput1::DuplicateOutput and DuplicateOutput1 answer, for any DXGI */
+struct IDXGIOutput;
+struct IDXGIOutputDuplication;
+HRESULT WINAPI RayeCaptureDuplicateOutput( struct IDXGIOutput *output, IUnknown *device,
+                                           UINT format_count, const int *formats,
+                                           struct IDXGIOutputDuplication **duplication );
+
+#endif /* WINE_UNIX_LIB */
+
+#endif
