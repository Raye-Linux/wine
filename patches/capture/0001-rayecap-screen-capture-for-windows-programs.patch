+/* errno values from the unix side */
+#define E_UNIX_EACCES     13
+#define E_UNIX_EAGAIN     11
+#define E_UNIX_EPIPE      32
+#define E_UNIX_ENOENT     2
+#define E_UNIX_ENOSPC     28
+#define E_UNIX_ETIMEDOUT  110
+
+static HRESULT hresult( int result )
+{
+    switch (-result)
+    {
+    case 0: return S_OK;
+    case E_UNIX_ETIMEDOUT:
+    case E_UNIX_EAGAIN: return HRESULT_FROM_WIN32( WAIT_TIMEOUT );
+    case E_UNIX_EACCES: return E_ACCESSDENIED;
+    case E_UNIX_EPIPE: return HRESULT_FROM_WIN32( ERROR_BROKEN_PIPE );
+    case E_UNIX_ENOSPC: return HRESULT_FROM_WIN32( ERROR_MORE_DATA );
+    case E_UNIX_ENOENT: return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    default: return E_FAIL;
+    }
+}
+
+static UINT64 handle( HRAYECAP session )
+{
+    return (ULONG_PTR)session;
+}
+
+/* the program's own path names it for the remembered choice */
+static char *utf8( const WCHAR *str )
+{
+    int len = WideCharToMultiByte( CP_UTF8, 0, str, -1, NULL, 0, NULL, NULL );
+    char *ret = malloc( len );
+    if (ret) WideCharToMultiByte( CP_UTF8, 0, str, -1, ret, len, NULL, NULL );
+    return ret;
+}
+
+HRESULT WINAPI RayeCaptureOpen( UINT kind, HRAYECAP *session )
+{
+    struct open_params params = { .kind = kind };
+    WCHAR path[MAX_PATH], *name;
+    NTSTATUS status;
+
+    if (!GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) )) path[0] = 0;
+    name = wcsrchr( path, '\\' );
+    params.app_key = utf8( path );
+    params.app_name = utf8( name ? name + 1 : path );
+
+    TRACE( "kind %u for %s\n", kind, debugstr_w( path ) );
+    status = WINE_UNIX_CALL( unix_open, &params );
+    free( (char *)params.app_key );
+    free( (char *)params.app_name );
+    if (status) return status == STATUS_NOT_SUPPORTED ? HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED ) : E_FAIL;
+    *session = (HRAYECAP)(ULONG_PTR)params.handle;
+    return S_OK;
+}
+
+void WINAPI RayeCaptureClose( HRAYECAP session )
+{
+    struct handle_params params = { .handle = handle( session ) };
+    if (session) WINE_UNIX_CALL( unix_close, &params );
+}
+
+UINT WINAPI RayeCaptureState( HRAYECAP session )
+{
+    struct handle_params params = { .handle = handle( session ) };
+    WINE_UNIX_CALL( unix_state, &params );
+    return params.state;
+}
+
+int WINAPI RayeCaptureFindStream( HRAYECAP session, const RECT *monitors, UINT count, UINT monitor )
+{
+    struct find_params params = { .handle = handle( session ), .monitors = monitors, .count = count,
+                                  .monitor = monitor };
+    WINE_UNIX_CALL( unix_find, &params );
+    return params.stream;
+}
+
+HRESULT WINAPI RayeCaptureStreamInfo( HRAYECAP session, int stream, RECT *rect, UINT *source )
+{
+    struct stream_params params = { .handle = handle( session ), .stream = stream };
+
+    WINE_UNIX_CALL( unix_stream_info, &params );
+    if (params.result) return E_INVALIDARG;
+    if (rect) *rect = params.rect;
+    if (source) *source = params.source;
+    return S_OK;
+}
+
+HRESULT WINAPI RayeCaptureWait( HRAYECAP session, int stream, UINT64 after_seq, INT64 after_cursor_ns,
+                                UINT timeout, struct rayecap_frame *frame )
+{
+    struct wait_params params = { .handle = handle( session ), .stream = stream, .after_seq = after_seq,
+                                  .after_cursor_ns = after_cursor_ns, .timeout = timeout };
+
+    WINE_UNIX_CALL( unix_wait, &params );
+    if (frame) *frame = params.frame;
+    return hresult( params.result );
+}
+
+HRESULT WINAPI RayeCaptureCopy( HRAYECAP session, int stream, const RECT *src, void *dst, UINT pitch,
+                                UINT flags, struct rayecap_frame *frame )
+{
+    struct copy_params params = { .handle = handle( session ), .stream = stream, .src = *src, .dst = dst,
+                                  .pitch = pitch, .flags = flags };
+
+    WINE_UNIX_CALL( unix_copy, &params );
+    if (frame) *frame = params.frame;
+    return hresult( params.result );
+}
+
+HRESULT WINAPI RayeCaptureCopyCursor( HRAYECAP session, int stream, void *dst, UINT pitch,
+                                      UINT max_width, UINT max_height, struct rayecap_frame *frame )
+{
+    struct cursor_params params = { .handle = handle( session ), .stream = stream, .dst = dst, .pitch = pitch,
+                                    .max_width = max_width, .max_height = max_height };
+
+    WINE_UNIX_CALL( unix_copy_cursor, &params );
+    if (frame) *frame = params.frame;
+    return hresult( params.result );
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( instance );
+        if (__wine_init_unix_call()) return FALSE;
+    }
+    return TRUE;
+}
