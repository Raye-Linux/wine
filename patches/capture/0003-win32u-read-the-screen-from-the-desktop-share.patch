diff --git a/dlls/win32u/screencap.c b/dlls/win32u/screencap.c
new file mode 100644
index 0000000..682731a
--- /dev/null
+++ b/dlls/win32u/screencap.c
@@ -0,0 +1,332 @@
+/*
+ * GDI reads of the screen (BitBlt from GetDC(0) and friends), answered with
+ * what the desktop really shows, through the system share picker.
+ *
+ * Copyright 2026 Raye Linux
+ *
