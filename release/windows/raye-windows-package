"""Opens an app package from the Microsoft Store (.msix, .appx and their
bundles), the files a double-click on one hands over.

    raye-windows-package FILE            open it
    raye-windows-package --inspect FILE  what it is, as JSON, nothing run

Two kinds of app come in these files:

- a classic desktop program the publisher wrapped for the Store
  (EntryPoint Windows.FullTrustApplication, or a packaged classic app).
  Its files are plain Windows files: they are unpacked in
  ~/.local/share/raye/windows/packages/<name>, the package's own DLLs
  next to the program as Windows would find them, a Start entry with the
  package's icon is made, and raye-run-windows starts it in its own
  space like any .exe;
- a Store app in the strict sense (UWP, or built on the Windows App
  SDK). Those need parts of Windows the layer does not have: they are
  not started, and the person is told so in plain words, with the Linux
  or web version when Raye knows one.

A package for ARM processors only is refused the same way.
"""
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile

HOME = pathlib.Path(os.environ.get("XDG_DATA_HOME") or pathlib.Path.home() / ".local" / "share")
PACKAGES = HOME / "raye" / "windows" / "packages"
APPS = HOME / "applications"

# Files that describe the package rather than belong to the program.
BOOKKEEPING = ("AppxSignature.p7x", "AppxBlockMap.xml", "[Content_Types].xml",
               "AppxManifest.xml")
# Architectures this computer can run, best first.
ARCHES = ("x64", "x86", "neutral")
# Frameworks that bring Windows UI the layer does not implement.
UNSUPPORTED_DEPS = ("Microsoft.WindowsAppRuntime", "Microsoft.UI.Xaml",
                    "Microsoft.NET.Native", "Microsoft.Services.Store")
# Where Windows puts a package's VFS folders, for each architecture: these
# DLLs are found next to the program.
SYSTEM_VFS = {"x64": ("SystemX64", "System"), "x86": ("SystemX86", "System"),
              "neutral": ("SystemX64", "SystemX86", "System")}

# Store apps people bring most, by package name, and where to get them on
# Raye instead. store is a Store id, web a page that does the same.
ALTERNATIVES = {
    "SpotifyAB.SpotifyMusic": {"store": "com.spotify.Client"},
    "5319275A.WhatsAppDesktop": {"web": "https://web.whatsapp.com/"},
    "4DF9E0F8.Netflix": {"web": "https://www.netflix.com/"},
    "Microsoft.Todos": {"web": "https://to-do.office.com/"},
    "MSTeams": {"web": "https://teams.microsoft.com/"},
    "MicrosoftTeams": {"web": "https://teams.microsoft.com/"},
    "Microsoft.WindowsTerminal": {"store": "org.kde.konsole"},
    "Microsoft.WindowsNotepad": {"store": "org.kde.kate"},
    "Microsoft.Paint": {"store": "org.kde.kolourpaint"},
    "Microsoft.WindowsCalculator": {"store": "org.kde.kcalc"},
    "Microsoft.ZuneMusic": {"store": "org.videolan.VLC"},
    "Microsoft.ZuneVideo": {"store": "org.videolan.VLC"},
    "Microsoft.OutlookForWindows": {"web": "https://outlook.live.com/"},
    "Microsoft.MicrosoftStickyNotes": {"web": "https://www.onenote.com/stickynotes"},
    "Facebook.InstagramBeta": {"web": "https://www.instagram.com/"},
    "BytedancePte.Ltd.TikTok": {"web": "https://www.tiktok.com/"},
    "Disney.37853FC22B2CE": {"web": "https://www.disneyplus.com/"},
    "AmazonVideo.PrimeVideo": {"web": "https://www.primevideo.com/"},
    "Discord.Discord": {"store": "com.discordapp.Discord"},
    "Telegram.TelegramDesktop": {"store": "org.telegram.desktop"},
    "Microsoft.MinecraftUWP": {"store": "com.mojang.Minecraft"},
