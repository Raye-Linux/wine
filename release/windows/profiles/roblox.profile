# The Roblox player, which is NOT Roblox Studio. Roblox blocks this
# system on purpose: its Hyperion anti-tamper refuses the layer, and the
# publisher withdrew what support it had (areweanticheatyet.com
# games.json @ 6c26305, update "Wine Support Yanked", 2024-03-01).
# There is no way around it here, and there will not be one: getting
# around an anti-cheat bans the player's account.
# This profile exists so the download is named and refused early. The
# answer lives in titles/00-raye.titles under [roblox]; the runner shows
# it once it reads title=.
name="Roblox"
match="robloxplayer*"
verbs=""
title="roblox"
