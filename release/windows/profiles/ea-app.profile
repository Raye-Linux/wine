# EA app: a launcher. The games it starts get Game Mode, the app does not.
name="EA app"
match="eaappinstaller*.exe"
title="ea-app"
game="launcher"
launcher="EADesktop.exe;EALauncher.exe;EABackgroundService.exe;EALocalHostSvc.exe;EACefSubProcess.exe;EAConnect_microsoft.exe;EACrashReporter.exe;EAUpdater.exe;ErrorReporter.exe;Link2EA.exe"
