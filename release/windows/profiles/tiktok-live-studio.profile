# TikTok LIVE Studio. TikTok hands out its setup only to a signed-in
# account, so the Store sends people to its page; the small downloader
# they get (tiktok_live_studio_downloader-...exe) fetches and installs
# the app in this same space.
name="TikTok LIVE Studio"
match="tiktok_live_studio* tiktok?live?studio*"
title="tiktok-live-studio"
